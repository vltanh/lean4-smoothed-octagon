module

public import SmoothedOctagon.Exclusion.Forward.Scalars.Canon

/-!
# Case F scalars: the larger-norm residual

On the symmetric domain `1 ≤ z = w ≤ 4/3`, `1 + 6z/5 ≤ U < 3`, `S²/Z ≤ h ≤ S(5U - 2 - 3z)/(3Z)`, the
larger-norm residual `𝓔_v = r - nL(z, h) - m/64` is negative.

## Main API

* `fs_resV_canon`: `𝓔_v` is a canonical function of the exterior factor (`fs_cf`).
* `fs_P_nonneg`: the concavity polynomial is nonnegative.
* `fs_V_E_neg`, `fs_V_T_neg`: the two tangent values in the coordinates `a = (z - 1)/(z + 1)`,
  `t = I - 1`.
* `fs_resV_neg`: the sign.
-/

@[expose] public section

namespace SmoothedOctagon

open Real Set

/-! ### The canonical form -/

/-- Constant coefficient of `𝓔_v` as a canonical function of `h` (`Φ` an atom). -/
noncomputable def fs_V0 (U z Φ : ℝ) : ℝ :=
  -z * (1 + U) * Φ / (z ^ 2 + U) - z * (8 * U ^ 2 * (1 + z) - 17 * U * z ^ 2 - 210 * U * z - 129 * U +
    64 * z ^ 3 + 367 * z ^ 2 + 230 * z - 9) / (64 * (z ^ 2 + U) * (1 + z))

/-- Linear coefficient of `𝓔_v`. -/
noncomputable def fs_V1 (U z Φ : ℝ) : ℝ :=
  (1 + U) * (1 + z) * Φ / (z ^ 2 + U) + (8 * U ^ 2 * z ^ 2 + 16 * U ^ 2 * z - 7 * U ^ 2 +
    47 * U * z ^ 3 - 163 * U * z ^ 2 - 147 * U * z + 33 * U - 64 * z ^ 4 + 175 * z ^ 3 +
    213 * z ^ 2 - 35 * z - 24) / (64 * (z ^ 2 + U) * (1 + z))

/-- The canonical form of `𝓔_v` (`w = z`), with `Φ` kept as an atom. -/
theorem fs_resV_canon {U z h : ℝ} (hU : 0 < U) (hz : 0 < z) (hh : 0 < h) (hh1 : h ≠ 1) :
    ff_resV U z z h = fs_cf (fs_V0 U z (ff_Phi U z z)) (fs_V1 U z (ff_Phi U z z))
      (z ^ 2 * (z - U) / (z ^ 2 + U)) (z ^ 2 * (1 + z) / (z ^ 2 + U)) z
      (z * (U - z) * (1 + z) / (z ^ 2 + U)) h := by
  have hZ : 0 < z ^ 2 + U := by positivity
  have hS : 0 < 1 + z := by linarith
  have hK : 0 < 1 + U := by linarith
  have hh1' : h - 1 ≠ 0 := sub_ne_zero.2 hh1
  unfold ff_resV ff_r ff_n ff_L ff_m ff_q fs_cf fs_V0 fs_V1
  simp only [ff_f]
  generalize ff_Phi U z z = Φ
  generalize Real.log h = L
  field_simp
  ring

/-- The concavity polynomial `P(s) = (U - z)s²(2zs - S) + Zs - 2zS ≥ 0` for `s ≥ S²/Z`; it controls
the sign of the second derivative of `𝓔_v` in `h`. -/
theorem fs_P_nonneg {U z s : ℝ} (hz : 1 ≤ z) (hz' : z ≤ 4 / 3) (hU : 1 + 6 * z / 5 ≤ U) (hU3 : U ≤ 3)
    (hs : (1 + z) ^ 2 / (z ^ 2 + U) ≤ s) :
    0 ≤ (U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z) := by
  have hU0 : 0 < U := by linarith
  have hZ : 0 < z ^ 2 + U := by positivity
  have hI1 : 1 ≤ (1 + z) ^ 2 / (z ^ 2 + U) := by rw [le_div_iff₀ hZ]; nlinarith
  have hQ : (1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
      z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) ≤ 0 := by
    have hU₀0 : 0 < 1 + 6 * z / 5 := by linarith
    set U₀ := 1 + 6 * z / 5
    have e : (1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
        z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) =
        ((1 - z) * U₀ ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U₀ +
          z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2)) -
        (U - U₀) * ((z - 1) * (U + U₀) + z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3)) := by ring
    have h1 : 0 ≤ (U - U₀) * ((z - 1) * (U + U₀) + z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3)) := by
      apply mul_nonneg (by linarith)
      have : 0 ≤ (z - 1) * (U + U₀) := mul_nonneg (by linarith) (by linarith)
      have : 0 ≤ z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) := by positivity
      linarith
    have h2 : (1 - z) * U₀ ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U₀ +
        z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) ≤ 0 := by
      obtain ⟨x, rfl⟩ : ∃ x, z = 1 + x := ⟨z - 1, by ring⟩
      have hx0 : 0 ≤ x := by linarith
      have hx1 : x ≤ 1 / 3 := by linarith
      have e2 : (1 - (1 + x)) * U₀ ^ 2 - (1 + x) * ((1 + x) ^ 3 + 7 * (1 + x) ^ 2 + 5 * (1 + x) + 3) * U₀ +
          (1 + x) ^ 2 * ((1 + x) ^ 4 + 2 * (1 + x) ^ 3 + 6 * (1 + x) ^ 2 + 5 * (1 + x) + 2) =
          x ^ 6 + 34 / 5 * x ^ 5 + 78 / 5 * x ^ 4 + 124 / 25 * x ^ 3 - 832 / 25 * x ^ 2 -
            1216 / 25 * x - 96 / 5 := by simp only [U₀]; ring
      rw [e2]
      have : x ^ 6 + 34 / 5 * x ^ 5 + 78 / 5 * x ^ 4 + 124 / 25 * x ^ 3 ≤ 13 * x ^ 2 := by
        have h3 : x ^ 3 ≤ x ^ 2 / 3 := by nlinarith [sq_nonneg x]
        have h4 : x ^ 4 ≤ x ^ 2 / 9 := by nlinarith [sq_nonneg x, pow_nonneg hx0 3]
        have h5 : x ^ 5 ≤ x ^ 2 / 27 := by nlinarith [sq_nonneg x, pow_nonneg hx0 4]
        have h6 : x ^ 6 ≤ x ^ 2 / 81 := by nlinarith [sq_nonneg x, pow_nonneg hx0 5]
        nlinarith
      nlinarith
    linarith
  set I := (1 + z) ^ 2 / (z ^ 2 + U) with hIdef
  have hPI : 0 ≤ (U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z) := by
    have e : (U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z) =
        -((1 + z) * (2 * z + 1 - U) * ((1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
          z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2))) / (z ^ 2 + U) ^ 3 := by
      rw [hIdef]; field_simp; ring
    rw [e]
    apply div_nonneg _ (by positivity)
    have : 0 ≤ (1 + z) * (2 * z + 1 - U) := mul_nonneg (by linarith) (by linarith)
    nlinarith
  have hM : 0 ≤ (U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U) := by
    have hs1 : 1 ≤ s := le_trans hI1 hs
    have h1 : (1 + z) * (s + I) ≤ 2 * z * (s ^ 2 + s * I + I ^ 2) := by
      have : s + I ≤ s ^ 2 + s * I + I ^ 2 := by nlinarith
      have : 0 ≤ s + I := by linarith
      nlinarith
    have : 0 ≤ U - z := by linarith
    nlinarith
  have e : (U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z) =
      ((U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z)) +
      (s - I) * ((U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U)) := by
    ring
  rw [e]
  have : 0 ≤ (s - I) * ((U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U)) :=
    mul_nonneg (by linarith) hM
  linarith

/-! ### The two tangent values -/

theorem fs_V_C0 {a t : ℝ} (hx0 : 0 ≤ a) (hx1 : a ≤ 1 / 7)
    (hy0 : 0 ≤ t) (hy1 : t ≤ 1 / 4) :
    0 ≤ a ^ (3:ℕ) * t + a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (6) * a ^ (2:ℕ) * t - (5) * a ^ (2:ℕ) + (3) * a * t + (3) * a - t ^ (2:ℕ) - (2) * t + (1) := by
  have b1 : 0 ≤ a := by linarith
  have b2 : 0 ≤ (1 / 7 - a) := by linarith
  have b3 : 0 ≤ t := by linarith
  have b4 : 0 ≤ (1 / 4 - t) := by linarith
  have key : a ^ (3:ℕ) * t + a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (6) * a ^ (2:ℕ) * t - (5) * a ^ (2:ℕ) + (3) * a * t + (3) * a - t ^ (2:ℕ) - (2) * t + (1) =
      (5488) * (1 / 7 - a) ^ (3:ℕ) * (1 / 4 - t) ^ (2:ℕ) +
      (8232) * (1 / 7 - a) ^ (3:ℕ) * t * (1 / 4 - t) +
      (2401) * (1 / 7 - a) ^ (3:ℕ) * t ^ (2:ℕ) +
      (18816) * a * (1 / 7 - a) ^ (2:ℕ) * (1 / 4 - t) ^ (2:ℕ) +
      (29988) * a * (1 / 7 - a) ^ (2:ℕ) * t * (1 / 4 - t) +
      (10143) * a * (1 / 7 - a) ^ (2:ℕ) * t ^ (2:ℕ) +
      (20608) * a ^ (2:ℕ) * (1 / 7 - a) * (1 / 4 - t) ^ (2:ℕ) +
      (33992) * a ^ (2:ℕ) * (1 / 7 - a) * t * (1 / 4 - t) +
      (12334) * a ^ (2:ℕ) * (1 / 7 - a) * t ^ (2:ℕ) +
      (7296) * a ^ (3:ℕ) * (1 / 4 - t) ^ (2:ℕ) +
      (12272) * a ^ (3:ℕ) * t * (1 / 4 - t) +
      (4612) * a ^ (3:ℕ) * t ^ (2:ℕ) := by ring
  have pos : 0 ≤ a ^ (3:ℕ) * t + a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (6) * a ^ (2:ℕ) * t - (5) * a ^ (2:ℕ) + (3) * a * t + (3) * a - t ^ (2:ℕ) - (2) * t + (1) := by
    rw [key]; clear key
    positivity
  linarith

