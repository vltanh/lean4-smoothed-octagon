/-- The tangent line over `[h₀, h_c]` is below the larger of its two end values. -/
theorem fs_tangent_comb {E D h0 h hc : ℝ} (hE : E < 0) (hT : E + (hc - h0) * D < 0) (h1 : h0 ≤ h)
    (h2 : h ≤ hc) : E + (h - h0) * D < 0 := by
