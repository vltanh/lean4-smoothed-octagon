module

public import SmoothedOctagon.Exclusion.Forward.Scalars.Canon
public import SmoothedOctagon.Exclusion.Forward.Reduce

/-!
# Case F scalars: the neighbour residual

`HAND_FORWARD_NEIGHBOR_INTEGRAL`, `HAND_FORWARD_ASYMMETRIC_NEIGHBOR_BOUND`, reduced by
`HAND_FORWARD_LEMMAS` §1: the neighbour residual `𝓔 = αA - B - nF_{z/S}(h) - mF_{w/T}(T²/W)` is negative
on the comparison domain with `w ≥ 4/3`.

## Main API

* `fs_N0`, `fs_N1`, `fs_resN_canon`: `𝓔` is a canonical function of the exterior factor (`fs_cf`).
* `fs_P_nonneg'`, `fs_N_conc`: concavity in `h` for `1 ≤ z ≤ 5/3`.
* `fs_NSE_bound`, `fs_NST_bound` (symmetric face, coordinates `a`, `t`), `fs_NAE_bound`,
  `fs_NAT_bound` (asymmetric face `w = 4/3`): the two tangent values.
* `fs_tangent_comb`, `fs_NS_Eval`, `fs_NS_Tval`, `fs_NA_Eval`, `fs_NA_Tval`, `fs_resN_sym`,
  `fs_resN_asym`: the two faces.
* `fs_resN_le`: lowering the larger neighbour does not decrease `𝓔` (with `fs_A_sub_le`, `fs_m_sub`,
  `fs_F_ge`, `fs_F_mono_x`, `fs_F_mono_r`).
* `fs_resN_neg`: the sign.
-/

@[expose] public section

namespace SmoothedOctagon

open Real Set

/-! ### The canonical form of the neighbour residual -/

/-- Constant coefficient of `𝓔` (GLOBAL_FORWARD_NEIGHBOR_CONTRACTION (4)) as a canonical function of
`h`, with `A`, `q`, `V = F_{w/T}(T²/W)` as atoms. -/
noncomputable def fs_N0 (U z A V q : ℝ) : ℝ :=
  -(1 + U) * z * A / (z ^ 2 + U) - 1 + z ^ 2 / (1 + z) - z ^ 3 / (z ^ 2 + U) +
    (1 + z) ^ 2 * (U - z) / (z ^ 2 + U) + (1 + U) ^ 2 * V / ((1 + z) * (z ^ 2 + U)) * q * z

/-- Linear coefficient of `𝓔`. -/
noncomputable def fs_N1 (U z A V q : ℝ) : ℝ :=
  (1 + U) * (1 + z) * A / (z ^ 2 + U) - (z ^ 2 + U) / (1 + z) -
    (1 + z) ^ 2 * (U - z) / (z ^ 2 + U) * (1 - (z / (1 + z)) ^ 2) -
    (1 + U) ^ 2 * V / ((1 + z) * (z ^ 2 + U)) * (q * (1 + z) - 1)

/-- The canonical form of the neighbour residual. -/
theorem fs_resN_canon {U z w h : ℝ} (hU : 0 < U) (hz : 0 < z) (hh : 0 < h) (hh1 : h ≠ 1) :
    ff_resN U z w h = fs_cf (fs_N0 U z (ff_A U z w) (ff_F (w / (1 + w)) ((1 + w) ^ 2 / (w ^ 2 + U)))
        (ff_q U z w))
      (fs_N1 U z (ff_A U z w) (ff_F (w / (1 + w)) ((1 + w) ^ 2 / (w ^ 2 + U))) (ff_q U z w))
      (-(z ^ 2 * (U - z) / (z ^ 2 + U))) (z ^ 2 * (1 + z) / (z ^ 2 + U)) z
      (z * (1 + z) * (U - z) / (z ^ 2 + U)) h := by
  have hZ : 0 < z ^ 2 + U := by positivity
  have hS : 0 < 1 + z := by linarith
  have hK : 0 < 1 + U := by linarith
  have hh1' : h - 1 ≠ 0 := sub_ne_zero.2 hh1
  unfold ff_resN ff_alpha ff_B ff_n ff_m fs_cf fs_N0 fs_N1
  unfold ff_F
  generalize ff_A U z w = A
  generalize ff_q U z w = q
  generalize (1 + w) ^ 2 / (w ^ 2 + U) = r
  generalize Real.log h = L
  generalize hV : 1 + (w / (1 + w)) ^ 2 * r - w / (1 + w) * r * Real.log r / (r - 1) = V
  field_simp
  ring

/-- The concavity polynomial `P(s) ≥ 0` for `s ≥ S²/Z`, `1 ≤ z ≤ 5/3` (HAND_FORWARD_LEMMAS (2)-(5)). -/
theorem fs_P_nonneg' {U z s : ℝ} (hz : 1 ≤ z) (hz' : z ≤ 5 / 3) (hU : 1 + 6 * z / 5 ≤ U) (hU3 : U ≤ 3)
    (hs : (1 + z) ^ 2 / (z ^ 2 + U) ≤ s) :
    0 ≤ (U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z) := by
  have hU0 : 0 < U := by linarith
  have hZ : 0 < z ^ 2 + U := by positivity
  have hI1 : 1 ≤ (1 + z) ^ 2 / (z ^ 2 + U) := by rw [le_div_iff₀ hZ]; nlinarith
  have hQ : (1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
      z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) ≤ 0 := by
    have hU₀0 : 0 < 1 + 6 * z / 5 := by linarith
    set U₀ := 1 + 6 * z / 5
    have e : (1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
        z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) =
        ((1 - z) * U₀ ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U₀ +
          z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2)) -
        (U - U₀) * ((z - 1) * (U + U₀) + z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3)) := by ring
    have h1 : 0 ≤ (U - U₀) * ((z - 1) * (U + U₀) + z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3)) := by
      apply mul_nonneg (by linarith)
      have : 0 ≤ (z - 1) * (U + U₀) := mul_nonneg (by linarith) (by linarith)
      have : 0 ≤ z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) := by positivity
      linarith
    have h2 : (1 - z) * U₀ ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U₀ +
        z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2) ≤ 0 := by
      obtain ⟨x, rfl⟩ : ∃ x, z = 1 + x := ⟨z - 1, by ring⟩
      have hx0 : 0 ≤ x := by linarith
      have hx1 : x ≤ 2 / 3 := by linarith
      have e2 : (1 - (1 + x)) * U₀ ^ 2 - (1 + x) * ((1 + x) ^ 3 + 7 * (1 + x) ^ 2 + 5 * (1 + x) + 3) * U₀ +
          (1 + x) ^ 2 * ((1 + x) ^ 4 + 2 * (1 + x) ^ 3 + 6 * (1 + x) ^ 2 + 5 * (1 + x) + 2) =
          x ^ 6 + 34 / 5 * x ^ 5 + 78 / 5 * x ^ 4 + 124 / 25 * x ^ 3 - 832 / 25 * x ^ 2 -
            1216 / 25 * x - 96 / 5 := by simp only [U₀]; ring
      rw [e2]
      have : x ^ 6 + 34 / 5 * x ^ 5 + 78 / 5 * x ^ 4 + 124 / 25 * x ^ 3 ≤ 13 * x ^ 2 := by
        have h3 : x ^ 3 ≤ 2 / 3 * x ^ 2 := by nlinarith [sq_nonneg x]
        have h4 : x ^ 4 ≤ 4 / 9 * x ^ 2 := by nlinarith [sq_nonneg x, pow_nonneg hx0 3]
        have h5 : x ^ 5 ≤ 8 / 27 * x ^ 2 := by nlinarith [sq_nonneg x, pow_nonneg hx0 4]
        have h6 : x ^ 6 ≤ 16 / 81 * x ^ 2 := by nlinarith [sq_nonneg x, pow_nonneg hx0 5]
        nlinarith
      nlinarith
    linarith
  set I := (1 + z) ^ 2 / (z ^ 2 + U) with hIdef
  have hPI : 0 ≤ (U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z) := by
    have e : (U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z) =
        -((1 + z) * (2 * z + 1 - U) * ((1 - z) * U ^ 2 - z * (z ^ 3 + 7 * z ^ 2 + 5 * z + 3) * U +
          z ^ 2 * (z ^ 4 + 2 * z ^ 3 + 6 * z ^ 2 + 5 * z + 2))) / (z ^ 2 + U) ^ 3 := by
      rw [hIdef]; field_simp; ring
    rw [e]
    apply div_nonneg _ (by positivity)
    have : 0 ≤ (1 + z) * (2 * z + 1 - U) := mul_nonneg (by linarith) (by linarith)
    nlinarith
  have hM : 0 ≤ (U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U) := by
    have hs1 : 1 ≤ s := le_trans hI1 hs
    have h1 : (1 + z) * (s + I) ≤ 2 * z * (s ^ 2 + s * I + I ^ 2) := by
      have : s + I ≤ s ^ 2 + s * I + I ^ 2 := by nlinarith
      have : 0 ≤ s + I := by linarith
      nlinarith
    have : 0 ≤ U - z := by linarith
    nlinarith
  have e : (U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z) =
      ((U - z) * I ^ 2 * (2 * z * I - (1 + z)) + (z ^ 2 + U) * I - 2 * z * (1 + z)) +
      (s - I) * ((U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U)) := by
    ring
  rw [e]
  have : 0 ≤ (s - I) * ((U - z) * (2 * z * (s ^ 2 + s * I + I ^ 2) - (1 + z) * (s + I)) + (z ^ 2 + U)) :=
    mul_nonneg (by linarith) hM
  linarith

/-- The concavity condition of the neighbour residual on `[S²/Z, h]`. -/
theorem fs_N_conc {U z s : ℝ} (hz : 1 ≤ z) (hz' : z ≤ 5 / 3) (hU : 1 + 6 * z / 5 ≤ U) (hU3 : U ≤ 3)
    (hs : (1 + z) ^ 2 / (z ^ 2 + U) ≤ s) :
    2 * -(z ^ 2 * (U - z) / (z ^ 2 + U)) * s ^ 3 + 2 * (z ^ 2 * (1 + z) / (z ^ 2 + U)) +
      z * (1 + z) * (U - z) / (z ^ 2 + U) * s ^ 2 - z * s ≤ 0 := by
  have hP := fs_P_nonneg' hz hz' hU hU3 hs
  have hU0 : 0 < U := by linarith
  have hZ : 0 < z ^ 2 + U := by positivity
  have e : 2 * -(z ^ 2 * (U - z) / (z ^ 2 + U)) * s ^ 3 + 2 * (z ^ 2 * (1 + z) / (z ^ 2 + U)) +
      z * (1 + z) * (U - z) / (z ^ 2 + U) * s ^ 2 - z * s =
      -(z * ((U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z)) /
        (z ^ 2 + U)) := by
    field_simp; ring
  rw [e]
  have : 0 ≤ z * ((U - z) * s ^ 2 * (2 * z * s - (1 + z)) + (z ^ 2 + U) * s - 2 * z * (1 + z)) /
      (z ^ 2 + U) := by
    have : 0 ≤ z := by linarith
    positivity
  linarith

