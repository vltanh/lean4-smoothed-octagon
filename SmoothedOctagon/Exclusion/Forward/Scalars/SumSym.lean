module

public import SmoothedOctagon.Exclusion.Forward.Scalars.Canon

/-!
# Case F scalars: the symmetric sum residual

On the symmetric domain `1 ≤ z = w ≤ 4/3`, `1 + 6z/5 ≤ U < 3`, `S²/Z ≤ h ≤ S(5U - 2 - 3z)/(3Z)`, the
sum residual `𝓔_Σ = r - n/35 - (m - n)L(z, I)` is negative.

Coordinates `a = (z - 1)/(z + 1) ∈ [0, 1/7]`, `t = I - 1 ∈ (0, 1/4]`, `I = S²/Z`; logarithms
`LI = log I = log(1 + t)`, `Lc = log(K/Z) = log(1 - aI)`.

## Main API

* `fs_SA0`, `fs_SA1`: the coefficients of `𝓔_Σ = A₀ + A₁H + z(DH²/(2h) - f(h))` (`fs_resS_decomp`).
* `fs_Spsi`, `fs_Sdpsi`: the Padé envelope `Ψ(τ)` of `𝓔_Σ/H` and its derivative; `fs_Spsi_tangent`.
* `fs_SA0_bound` (`A₀ ≤ 0`), `fs_SE3_bound`, `fs_SE4_bound` (the two tangent values), with the
  identities `fs_SE3_eq`, `fs_SE4_eq`.
* `fs_resS_neg`: the sign.
-/

@[expose] public section

namespace SmoothedOctagon

open Real Set

/-- `A₀ = 𝓔_Σ(h = 1)` in the coordinates `a = (z - 1)/(z + 1)`, `t = I - 1`, with `LI = log I`,
`Lc = log(1 - aI)` kept as atoms. -/
noncomputable def fs_SA0 (a t LI Lc : ℝ) : ℝ := ((1 / 2) * a ^ (4:ℕ) * t ^ (2:ℕ) + a ^ (4:ℕ) * t + (1 / 2) * a ^ (4:ℕ) + (3 / 2) * a ^ (3:ℕ) * t ^ (2:ℕ) + (5 / 2) * a ^ (3:ℕ) * t + a ^ (3:ℕ) + (3 / 2) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3 / 2) * a ^ (2:ℕ) + (1 / 2) * a * t ^ (2:ℕ) - (3 / 2) * a * t) / ((1 - a)) + (-a ^ (3:ℕ) * t ^ (2:ℕ) - (2) * a ^ (3:ℕ) * t - a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a ^ (2:ℕ) * t + (3) * a * t + a) / ((1 - a) * t) * LI + (-a * t - a + (1)) / (1) * Lc

/-- The coefficient `A₁` of `H` in `𝓔_Σ = A₀ + A₁H + z(DH²/(2h) - f(h))`. -/
noncomputable def fs_SA1 (a t LI Lc : ℝ) : ℝ :=
  -((35) * a ^ (5:ℕ) * t ^ (2:ℕ) + (70) * a ^ (5:ℕ) * t + (35) * a ^ (5:ℕ) + (35) * a ^ (4:ℕ) * t ^ (2:ℕ) - (35) * a ^ (4:ℕ) - (70) * a ^ (3:ℕ) * t ^ (2:ℕ) - (210) * a ^ (3:ℕ) * t - (105) * a ^ (3:ℕ) - (70) * a ^ (2:ℕ) * t ^ (2:ℕ) + (70) * a ^ (2:ℕ) * t + (105) * a ^ (2:ℕ) + (35) * a * t ^ (2:ℕ) + (206) * a * t - (4) * a + (35) * t ^ (2:ℕ) - (4) * t + (4)) / (70 * (1 - a) ^ 2) -
    (a ^ (3:ℕ) * t ^ (2:ℕ) + (2) * a ^ (3:ℕ) * t + a ^ (3:ℕ) + a ^ (2:ℕ) * t ^ (2:ℕ) - a ^ (2:ℕ) - (3) * a * t ^ (2:ℕ) - (6) * a * t - (2) * a - t ^ (2:ℕ)) / (t * (1 - a)) * LI +
    2 * (1 - a * (1 + t)) / (1 - a) * Lc

/-- `Ψ(τ) = A₀(1/τ - 1) + A₁ + z(Dτ/2 - τ²/(3(2 - τ)))`: the Padé upper bound of `𝓔_Σ/H`, `τ = H/h`. -/
noncomputable def fs_Spsi (A0 A1 D z τ : ℝ) : ℝ :=
  A0 * (1 / τ - 1) + A1 + z * (D * τ / 2 - τ ^ 2 / (3 * (2 - τ)))

/-- `Ψ'(τ)`. -/
noncomputable def fs_Sdpsi (A0 D z τ : ℝ) : ℝ :=
  -A0 / τ ^ 2 + z * (D / 2 - (4 * τ - τ ^ 2) / (3 * (2 - τ) ^ 2))

/-! ### Signs of the logarithmic forms -/

theorem fs_SA0_cI0 {a t : ℝ} (hx0 : 0 ≤ a) (hx1 : a ≤ 1 / 7)
    (hy0 : 0 ≤ t) (hy1 : t ≤ 1 / 4) :
    0 ≤ -a ^ (3:ℕ) * t ^ (2:ℕ) - (2) * a ^ (3:ℕ) * t - a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a ^ (2:ℕ) * t + (3) * a * t + a := by
  have b1 : 0 ≤ a := by linarith
  have b2 : 0 ≤ (1 / 7 - a) := by linarith
  have b3 : 0 ≤ t := by linarith
  have b4 : 0 ≤ (1 / 4 - t) := by linarith
  have q0 : 0 ≤ (16) * a - (16) * a ^ (3:ℕ) := by
    have k : (16) * a - (16) * a ^ (3:ℕ) =
        (784) * a * (1 / 7 - a) ^ (2:ℕ) + (1568) * a ^ (2:ℕ) * (1 / 7 - a) + (768) * a ^ (3:ℕ) := by ring
    rw [k]; clear k; positivity
  have q1 : 0 ≤ (44) * a - (12) * a ^ (2:ℕ) - (40) * a ^ (3:ℕ) := by
    have k : (44) * a - (12) * a ^ (2:ℕ) - (40) * a ^ (3:ℕ) =
        (2156) * a * (1 / 7 - a) ^ (2:ℕ) + (4228) * a ^ (2:ℕ) * (1 / 7 - a) + (2032) * a ^ (3:ℕ) := by ring
    rw [k]; clear k; positivity
  have q2 : 0 ≤ (28) * a - (15) * a ^ (2:ℕ) - (25) * a ^ (3:ℕ) := by
    have k : (28) * a - (15) * a ^ (2:ℕ) - (25) * a ^ (3:ℕ) =
        (1372) * a * (1 / 7 - a) ^ (2:ℕ) + (2639) * a ^ (2:ℕ) * (1 / 7 - a) + (1242) * a ^ (3:ℕ) := by ring
    rw [k]; clear k; positivity
  have key : -a ^ (3:ℕ) * t ^ (2:ℕ) - (2) * a ^ (3:ℕ) * t - a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a ^ (2:ℕ) * t + (3) * a * t + a =
      ((16) * a - (16) * a ^ (3:ℕ)) * (1 / 4 - t) ^ (2:ℕ) +
      ((44) * a - (12) * a ^ (2:ℕ) - (40) * a ^ (3:ℕ)) * t * (1 / 4 - t) +
      ((28) * a - (15) * a ^ (2:ℕ) - (25) * a ^ (3:ℕ)) * t ^ (2:ℕ) := by ring
  rw [key]; clear key
  positivity

theorem fs_SA0_cc0 {a t : ℝ} (hx0 : 0 ≤ a) (hx1 : a ≤ 1 / 7)
    (hy0 : 0 ≤ t) (hy1 : t ≤ 1 / 4) :
    0 ≤ -a * t - a + (1) := by
  have b1 : 0 ≤ a := by linarith
  have b2 : 0 ≤ (1 / 7 - a) := by linarith
  have b3 : 0 ≤ t := by linarith
  have b4 : 0 ≤ (1 / 4 - t) := by linarith
  have q0 : 0 ≤ (4) - (4) * a := by
    have k : (4) - (4) * a =
        (28) * (1 / 7 - a) + (24) * a := by ring
    rw [k]; clear k; positivity
  have q1 : 0 ≤ (4) - (5) * a := by
    have k : (4) - (5) * a =
        (28) * (1 / 7 - a) + (23) * a := by ring
    rw [k]; clear k; positivity
  have key : -a * t - a + (1) =
      ((4) - (4) * a) * (1 / 4 - t) +
      ((4) - (5) * a) * t := by ring
  rw [key]; clear key
  positivity

theorem fs_SA0_N0 {a t : ℝ} (hx0 : 0 ≤ a) (hx1 : a ≤ 1 / 7)
    (hy0 : 0 ≤ t) (hy1 : t ≤ 1 / 4) :
    0 ≤ (2) * a ^ (5:ℕ) * t ^ (7:ℕ) + (14) * a ^ (5:ℕ) * t ^ (6:ℕ) + (40) * a ^ (5:ℕ) * t ^ (5:ℕ) + (60) * a ^ (5:ℕ) * t ^ (4:ℕ) + (50) * a ^ (5:ℕ) * t ^ (3:ℕ) + (22) * a ^ (5:ℕ) * t ^ (2:ℕ) + (4) * a ^ (5:ℕ) * t - (2) * a ^ (4:ℕ) * t ^ (7:ℕ) - (13) * a ^ (4:ℕ) * t ^ (6:ℕ) - (37) * a ^ (4:ℕ) * t ^ (5:ℕ) - (61) * a ^ (4:ℕ) * t ^ (4:ℕ) - (61) * a ^ (4:ℕ) * t ^ (3:ℕ) - (34) * a ^ (4:ℕ) * t ^ (2:ℕ) - (8) * a ^ (4:ℕ) * t - a ^ (3:ℕ) * t ^ (6:ℕ) - (11) * a ^ (3:ℕ) * t ^ (5:ℕ) - (27) * a ^ (3:ℕ) * t ^ (4:ℕ) - (21) * a ^ (3:ℕ) * t ^ (3:ℕ) + (4) * a ^ (3:ℕ) * t - (9) * a ^ (2:ℕ) * t ^ (5:ℕ) - (9) * a ^ (2:ℕ) * t ^ (4:ℕ) + (12) * a ^ (2:ℕ) * t ^ (3:ℕ) + (12) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a * t ^ (5:ℕ) + (3) * a * t ^ (4:ℕ) + (8) * a * t ^ (3:ℕ) := by
  have b1 : 0 ≤ a := by linarith
  have b2 : 0 ≤ (1 / 7 - a) := by linarith
  have b3 : 0 ≤ t := by linarith
  have b4 : 0 ≤ (1 / 4 - t) := by linarith
  have q1 : 0 ≤ (16384) * a ^ (3:ℕ) - (32768) * a ^ (4:ℕ) + (16384) * a ^ (5:ℕ) := by
    have k : (16384) * a ^ (3:ℕ) - (32768) * a ^ (4:ℕ) + (16384) * a ^ (5:ℕ) =
        (802816) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (1376256) * a ^ (4:ℕ) * (1 / 7 - a) + (589824) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q2 : 0 ≤ (12288) * a ^ (2:ℕ) + (98304) * a ^ (3:ℕ) - (231424) * a ^ (4:ℕ) + (120832) * a ^ (5:ℕ) := by
    have k : (12288) * a ^ (2:ℕ) + (98304) * a ^ (3:ℕ) - (231424) * a ^ (4:ℕ) + (120832) * a ^ (5:ℕ) =
        (4214784) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (17461248) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (20658176) * a ^ (4:ℕ) * (1 / 7 - a) + (7532544) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q3 : 0 ≤ (2048) * a + (64512) * a ^ (2:ℕ) + (240384) * a ^ (3:ℕ) - (681216) * a ^ (4:ℕ) + (371200) * a ^ (5:ℕ) := by
    have k : (2048) * a + (64512) * a ^ (2:ℕ) + (240384) * a ^ (3:ℕ) - (681216) * a ^ (4:ℕ) + (371200) * a ^ (5:ℕ) =
        (4917248) * a * (1 / 7 - a) ^ (4:ℕ) + (41796608) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (107665152) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (104840960) * a ^ (4:ℕ) * (1 / 7 - a) + (34426368) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q4 : 0 ≤ (8384) * a + (134592) * a ^ (2:ℕ) + (304448) * a ^ (3:ℕ) - (1069888) * a ^ (4:ℕ) + (608000) * a ^ (5:ℕ) := by
    have k : (8384) * a + (134592) * a ^ (2:ℕ) + (304448) * a ^ (3:ℕ) - (1069888) * a ^ (4:ℕ) + (608000) * a ^ (5:ℕ) =
        (20129984) * a * (1 / 7 - a) ^ (4:ℕ) + (126684992) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (274193024) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (241361792) * a ^ (4:ℕ) * (1 / 7 - a) + (74331776) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q5 : 0 ≤ (12816) * a + (139440) * a ^ (2:ℕ) + (208144) * a ^ (3:ℕ) - (945680) * a ^ (4:ℕ) + (560000) * a ^ (5:ℕ) := by
    have k : (12816) * a + (139440) * a ^ (2:ℕ) + (208144) * a ^ (3:ℕ) - (945680) * a ^ (4:ℕ) + (560000) * a ^ (5:ℕ) =
        (30771216) * a * (1 / 7 - a) ^ (4:ℕ) + (170912784) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (338310112) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (280346976) * a ^ (4:ℕ) * (1 / 7 - a) + (82738432) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q6 : 0 ≤ (8672) * a + (71712) * a ^ (2:ℕ) + (71260) * a ^ (3:ℕ) - (446100) * a ^ (4:ℕ) + (275000) * a ^ (5:ℕ) := by
    have k : (8672) * a + (71712) * a ^ (2:ℕ) + (71260) * a ^ (3:ℕ) - (446100) * a ^ (4:ℕ) + (275000) * a ^ (5:ℕ) =
        (20821472) * a * (1 / 7 - a) ^ (4:ℕ) + (107883104) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (202212220) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (160938316) * a ^ (4:ℕ) * (1 / 7 - a) + (46062728) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have q7 : 0 ≤ (2192) * a + (14640) * a ^ (2:ℕ) + (9100) * a ^ (3:ℕ) - (87750) * a ^ (4:ℕ) + (56250) * a ^ (5:ℕ) := by
    have k : (2192) * a + (14640) * a ^ (2:ℕ) + (9100) * a ^ (3:ℕ) - (87750) * a ^ (4:ℕ) + (56250) * a ^ (5:ℕ) =
        (5262992) * a * (1 / 7 - a) ^ (4:ℕ) + (26073488) * a ^ (2:ℕ) * (1 / 7 - a) ^ (3:ℕ) + (47088412) * a ^ (3:ℕ) * (1 / 7 - a) ^ (2:ℕ) + (36394078) * a ^ (4:ℕ) * (1 / 7 - a) + (10172412) * a ^ (5:ℕ) := by ring
    rw [k]; clear k; positivity
  have key : (2) * a ^ (5:ℕ) * t ^ (7:ℕ) + (14) * a ^ (5:ℕ) * t ^ (6:ℕ) + (40) * a ^ (5:ℕ) * t ^ (5:ℕ) + (60) * a ^ (5:ℕ) * t ^ (4:ℕ) + (50) * a ^ (5:ℕ) * t ^ (3:ℕ) + (22) * a ^ (5:ℕ) * t ^ (2:ℕ) + (4) * a ^ (5:ℕ) * t - (2) * a ^ (4:ℕ) * t ^ (7:ℕ) - (13) * a ^ (4:ℕ) * t ^ (6:ℕ) - (37) * a ^ (4:ℕ) * t ^ (5:ℕ) - (61) * a ^ (4:ℕ) * t ^ (4:ℕ) - (61) * a ^ (4:ℕ) * t ^ (3:ℕ) - (34) * a ^ (4:ℕ) * t ^ (2:ℕ) - (8) * a ^ (4:ℕ) * t - a ^ (3:ℕ) * t ^ (6:ℕ) - (11) * a ^ (3:ℕ) * t ^ (5:ℕ) - (27) * a ^ (3:ℕ) * t ^ (4:ℕ) - (21) * a ^ (3:ℕ) * t ^ (3:ℕ) + (4) * a ^ (3:ℕ) * t - (9) * a ^ (2:ℕ) * t ^ (5:ℕ) - (9) * a ^ (2:ℕ) * t ^ (4:ℕ) + (12) * a ^ (2:ℕ) * t ^ (3:ℕ) + (12) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a * t ^ (5:ℕ) + (3) * a * t ^ (4:ℕ) + (8) * a * t ^ (3:ℕ) =
      ((16384) * a ^ (3:ℕ) - (32768) * a ^ (4:ℕ) + (16384) * a ^ (5:ℕ)) * t * (1 / 4 - t) ^ (6:ℕ) +
      ((12288) * a ^ (2:ℕ) + (98304) * a ^ (3:ℕ) - (231424) * a ^ (4:ℕ) + (120832) * a ^ (5:ℕ)) * t ^ (2:ℕ) * (1 / 4 - t) ^ (5:ℕ) +
      ((2048) * a + (64512) * a ^ (2:ℕ) + (240384) * a ^ (3:ℕ) - (681216) * a ^ (4:ℕ) + (371200) * a ^ (5:ℕ)) * t ^ (3:ℕ) * (1 / 4 - t) ^ (4:ℕ) +
      ((8384) * a + (134592) * a ^ (2:ℕ) + (304448) * a ^ (3:ℕ) - (1069888) * a ^ (4:ℕ) + (608000) * a ^ (5:ℕ)) * t ^ (4:ℕ) * (1 / 4 - t) ^ (3:ℕ) +
      ((12816) * a + (139440) * a ^ (2:ℕ) + (208144) * a ^ (3:ℕ) - (945680) * a ^ (4:ℕ) + (560000) * a ^ (5:ℕ)) * t ^ (5:ℕ) * (1 / 4 - t) ^ (2:ℕ) +
      ((8672) * a + (71712) * a ^ (2:ℕ) + (71260) * a ^ (3:ℕ) - (446100) * a ^ (4:ℕ) + (275000) * a ^ (5:ℕ)) * t ^ (6:ℕ) * (1 / 4 - t) +
