/-! ### Concavity in `τ = H/h` -/

/-- **The tangent bound of `Ψ`** (concave in `τ` when `A₀ ≤ 0`): exact remainder
`A₀(τ_c - τ)²/(ττ_c²) - 4z(τ - τ_c)²/(3(2 - τ)(2 - τ_c)²)`. -/
theorem fs_Spsi_tangent {A0 A1 D z τ τc : ℝ} (hA0 : A0 ≤ 0) (hz : 0 ≤ z) (hτ : 0 < τ) (hτ2 : τ < 2)
    (hτc : 0 < τc) (hτc2 : τc < 2) :
    fs_Spsi A0 A1 D z τ ≤ fs_Spsi A0 A1 D z τc + fs_Sdpsi A0 D z τc * (τ - τc) := by
  have h2 : 0 < 2 - τ := by linarith
  have h2c : 0 < 2 - τc := by linarith
  have e : fs_Spsi A0 A1 D z τ - (fs_Spsi A0 A1 D z τc + fs_Sdpsi A0 D z τc * (τ - τc)) =
      A0 * ((τc - τ) ^ 2 / (τ * τc ^ 2)) - z * (4 * (τ - τc) ^ 2 / (3 * (2 - τ) * (2 - τc) ^ 2)) := by
    unfold fs_Spsi fs_Sdpsi
    field_simp
    ring
  have t1 : A0 * ((τc - τ) ^ 2 / (τ * τc ^ 2)) ≤ 0 :=
    mul_nonpos_of_nonpos_of_nonneg hA0 (by positivity)
  have t2 : 0 ≤ z * (4 * (τ - τc) ^ 2 / (3 * (2 - τ) * (2 - τc) ^ 2)) := by positivity
  linarith

/-! ### The decomposition -/

/-- **The decomposition of `𝓔_Σ`** in the coordinates `a = (z - 1)/(z + 1)`,
`t = (2z + 1 - U)/(z² + U) = I - 1`: `𝓔_Σ = A₀ + A₁H + z(DH²/(2h) - f(h))`, `D = a + t + at`. -/
theorem fs_resS_decomp {U z h : ℝ} (hz : 1 ≤ z) (hU3 : U < 3) (hU : 0 < U) (hh : 0 < h) :
    ff_resS U z z h =
      fs_SA0 ((z - 1) / (z + 1)) ((2 * z + 1 - U) / (z ^ 2 + U))
        (Real.log (1 + (2 * z + 1 - U) / (z ^ 2 + U)))
        (Real.log (1 - (z - 1) / (z + 1) * (1 + (2 * z + 1 - U) / (z ^ 2 + U)))) +
      fs_SA1 ((z - 1) / (z + 1)) ((2 * z + 1 - U) / (z ^ 2 + U))
        (Real.log (1 + (2 * z + 1 - U) / (z ^ 2 + U)))
        (Real.log (1 - (z - 1) / (z + 1) * (1 + (2 * z + 1 - U) / (z ^ 2 + U)))) * (h - 1) +
      z * (((z - 1) / (z + 1) + (2 * z + 1 - U) / (z ^ 2 + U) +
        (z - 1) / (z + 1) * ((2 * z + 1 - U) / (z ^ 2 + U))) * (h - 1) ^ 2 / (2 * h) - ff_f h) := by
  have hz0 : 0 < z := by linarith
  have hS : 0 < 1 + z := by linarith
  have hS' : 0 < z + 1 := by linarith
  have hK : 0 < 1 + U := by linarith
  have hZ : 0 < z ^ 2 + U := by positivity
  have l1 : 1 + (2 * z + 1 - U) / (z ^ 2 + U) = (1 + z) ^ 2 / (z ^ 2 + U) := by
    field_simp; ring
  have l2 : 1 - (z - 1) / (z + 1) * (1 + (2 * z + 1 - U) / (z ^ 2 + U)) = (1 + U) / (z ^ 2 + U) := by
    field_simp; ring
  have l3 : (1 + z) ^ 2 / (z ^ 2 + U) - 1 = (2 * z + 1 - U) / (z ^ 2 + U) := by
    field_simp; ring
  have hb : 1 - (z - 1) / (z + 1) = 2 / (z + 1) := by field_simp; ring
  rw [l2, l1]
  unfold ff_resS ff_r ff_n ff_m ff_L ff_q fs_SA0 fs_SA1
  rw [fs_Phi_sym hU hz0, l3, hb]
  simp only [ff_f]
  generalize Real.log ((1 + z) ^ 2 / (z ^ 2 + U)) = LI
  generalize Real.log ((1 + U) / (z ^ 2 + U)) = Lc
  generalize Real.log h = Lh
  generalize hd : 2 * z + 1 - U = d
  have hd0 : d ≠ 0 := by rw [← hd]; linarith
  field_simp
  subst hd
  ring

/-! ### The sign -/

theorem fs_SE3_neg {a t : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1 / 7) (ht0 : 0 < t) (ht1 : t ≤ 1 / 4) :
    fs_Spsi (fs_SA0 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t))))
      (fs_SA1 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t)))) (a + t + a * t) ((1 + a) / (1 - a))
      ((2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) /
        (5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2))) < 0 :=
  (fs_SE3_eq ha0 ha1 ht0 ht1).trans_lt (fs_SE3_bound ha0 ha1 ht0 ht1)

theorem fs_SE4_neg {a t : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1 / 7) (ht0 : 0 < t) (ht1 : t ≤ 1 / 4)
    (h39 : 39 * a / 40 ≤ t) :
    fs_Spsi (fs_SA0 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t))))
      (fs_SA1 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t)))) (a + t + a * t) ((1 + a) / (1 - a))
      ((2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) /
        (5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2))) +
      fs_Sdpsi (fs_SA0 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t)))) (a + t + a * t)
        ((1 + a) / (1 - a)) ((2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) /
          (5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2))) *
        (t / (1 + t) - (2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) /
          (5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2))) < 0 :=
  (fs_SE4_eq ha0 ha1 ht0 ht1).trans_lt (fs_SE4_bound ha0 ha1 ht0 ht1 h39)

/-- The abstract envelope argument: Padé, `𝓔_Σ/H ≤ Ψ(τ)`, and the tangent of the concave `Ψ` at
`τ_c` over `[τ_I, τ_c]`. -/
theorem fs_S_abstract {A0 A1 D z h τc τt : ℝ} (hA0 : A0 ≤ 0) (hz : 0 < z) (hh1 : 1 < h)
    (hτc0 : 0 < τc) (hτc1 : τc < 1) (hle : (h - 1) / h ≤ τc) (hge : τt ≤ (h - 1) / h)
    (hE3 : fs_Spsi A0 A1 D z τc < 0)
    (hE4 : fs_Spsi A0 A1 D z τc + fs_Sdpsi A0 D z τc * (τt - τc) < 0) :
    A0 + A1 * (h - 1) + z * (D * (h - 1) ^ 2 / (2 * h) - ff_f h) < 0 := by
  have hh0 : 0 < h := by linarith
  have hH : 0 < h - 1 := by linarith
  have hpade := fs_f_ge_pade hh1.le
  have e : (h - 1) * fs_Spsi A0 A1 D z ((h - 1) / h) =
      A0 + A1 * (h - 1) + z * (D * (h - 1) ^ 2 / (2 * h) - (h - 1) ^ 3 / (3 * h * (h + 1))) := by
    unfold fs_Spsi
    have e1 : 1 / ((h - 1) / h) = h / (h - 1) := by rw [one_div_div]
    have e2 : 2 - (h - 1) / h = (h + 1) / h := by field_simp; ring
    rw [e1, e2]
    have : h + 1 ≠ 0 := by linarith
    field_simp
    ring
  have hτ0 : 0 < (h - 1) / h := div_pos hH hh0
  have hτ1 : (h - 1) / h < 1 := by rw [div_lt_one hh0]; linarith
  have htan := fs_Spsi_tangent (A1 := A1) (D := D) hA0 hz.le hτ0 (by linarith) hτc0 (by linarith)
  have hpsi : fs_Spsi A0 A1 D z ((h - 1) / h) < 0 := by
    rcases le_total 0 (fs_Sdpsi A0 D z τc) with hd | hd
    · nlinarith
    · nlinarith
  have := mul_le_mul_of_nonneg_left hpade hz.le
  nlinarith

/-- The sign in the coordinates `(a, t, h)`. -/
theorem fs_S_at {a t h z : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1 / 7) (ht0 : 0 < t) (ht1 : t ≤ 1 / 4)
    (h39 : 39 * a / 40 ≤ t) (hza : z = (1 + a) / (1 - a)) (hhl : 1 + t ≤ h)
    (hhu : h ≤ 1 + (2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) / (3 * (1 - a))) :
    fs_SA0 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t))) +
      fs_SA1 a t (Real.log (1 + t)) (Real.log (1 - a * (1 + t))) * (h - 1) +
      z * ((a + t + a * t) * (h - 1) ^ 2 / (2 * h) - ff_f h) < 0 := by
  have hb : 0 < 1 - a := by linarith
  have hh1 : 1 < h := by linarith
  have hh0 : 0 < h := by linarith
  have hP1 : 0 < 2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2) := by
    nlinarith [mul_nonneg ha0 ht0.le, mul_nonneg (mul_nonneg ha0 ha0) ht0.le]
  have hP2 : 0 < 5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2) := by
    nlinarith [mul_nonneg ha0 ht0.le, mul_nonneg (mul_nonneg ha0 ha0) ht0.le]
  have hle : (h - 1) / h ≤ (2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) /
      (5 - 3 * a - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2)) := by
    rw [div_le_div_iff₀ hh0 hP2]
    have : (h - 1) * (3 * (1 - a)) ≤ 2 - 2 * a ^ 2 - t * (5 + 3 * a + 2 * a ^ 2) := by
      have := hhu
      rw [← sub_le_iff_le_add', le_div_iff₀ (by positivity)] at this
      linarith
    nlinarith
  have hge : t / (1 + t) ≤ (h - 1) / h := by
    rw [div_le_div_iff₀ (by linarith) hh0]; nlinarith
  rw [hza]
  exact fs_S_abstract (fs_SA0_bound ha0 ha1 ht0 ht1) (by positivity) hh1 (div_pos hP1 hP2)
    (by rw [div_lt_one hP2]; linarith) hle hge (fs_SE3_neg ha0 ha1 ht0 ht1)
    (fs_SE4_neg ha0 ha1 ht0 ht1 h39)

/-- **The symmetric sum sign**: `𝓔_Σ < 0` on the symmetric domain. After the decomposition and the
Padé bound, `𝓔_Σ/H ≤ Ψ(τ)`, `τ = H/h`, is concave in `τ` (`A₀ ≤ 0`); its tangent at the cost
endpoint `τ_c` gives the two values `E₃ = Ψ(τ_c)` and `E₄ = Ψ(τ_c) + Ψ'(τ_c)(τ_I - τ_c)`, signed
(like `A₀`) by the Padé bound for `log I`, the cubic bound for `log(1 - aI)` and Bernstein
expansions. -/
theorem fs_resS_neg {U z h : ℝ} (hz : 1 ≤ z) (hz' : z ≤ 4 / 3) (hU : 1 + 6 * z / 5 ≤ U)
    (hU3 : U < 3) (hhl : (1 + z) ^ 2 / (z ^ 2 + U) ≤ h)
    (hhu : h ≤ (1 + z) * (5 * U - 2 - 3 * z) / (3 * (z ^ 2 + U))) : ff_resS U z z h < 0 := by
  have hU0 : 0 < U := by linarith
  have hz0 : 0 < z := by linarith
  have hZ : 0 < z ^ 2 + U := by positivity
  have hz1 : 0 < z + 1 := by linarith
  have hI1 : 1 < (1 + z) ^ 2 / (z ^ 2 + U) := by rw [lt_div_iff₀ hZ]; nlinarith
  have hh0 : 0 < h := by linarith
  rw [fs_resS_decomp hz hU3 hU0 hh0]
  have hb' : 1 - (z - 1) / (z + 1) = 2 / (z + 1) := by field_simp; ring
  refine fs_S_at (by apply div_nonneg <;> linarith) (by rw [div_le_iff₀ hz1]; linarith)
    (by apply div_pos _ hZ; linarith) (by rw [div_le_iff₀ hZ]; nlinarith) ?_ ?_ ?_ ?_
  · have key : 39 * (z - 1) * (z ^ 2 + U) ≤ 40 * (2 * z + 1 - U) * (z + 1) := by
      have e : 39 * (z - 1) * (z ^ 2 + U) - 40 * (2 * z + 1 - U) * (z + 1) =
          ((z - 1) ^ 2 * (39 * z - 41) - 4 * (z - 1)) - (3 - U) * (39 * (z - 1) + 40 * (z + 1)) := by
        ring
      have h1 : (z - 1) ^ 2 * (39 * z - 41) ≤ (z - 1) * (11 / 3) := by
        have : (z - 1) * (39 * z - 41) ≤ 11 / 3 := by nlinarith
        nlinarith [sub_nonneg.2 hz]
      have h2 : 0 ≤ (3 - U) * (39 * (z - 1) + 40 * (z + 1)) := mul_nonneg (by linarith) (by linarith)
      nlinarith
    rw [mul_div_assoc', div_div, div_le_div_iff₀ (by positivity) hZ]
    nlinarith [key]
  · rw [hb']; field_simp; ring
  · calc 1 + (2 * z + 1 - U) / (z ^ 2 + U) = (1 + z) ^ 2 / (z ^ 2 + U) := by field_simp; ring
      _ ≤ h := hhl
  · refine le_trans hhu (le_of_eq ?_)
    rw [hb']
    field_simp
    ring

end SmoothedOctagon
