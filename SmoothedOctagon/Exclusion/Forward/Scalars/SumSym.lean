/-- The cleared numerator of the bounded `A0` value has the required sign. -/
theorem fs_SA0_Nsign {a t : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1 / 7) (ht0 : 0 < t) (ht1 : t ≤ 1 / 4) :
    -(2) * a ^ (5:ℕ) * t ^ (7:ℕ) - (14) * a ^ (5:ℕ) * t ^ (6:ℕ) - (40) * a ^ (5:ℕ) * t ^ (5:ℕ) - (60) * a ^ (5:ℕ) * t ^ (4:ℕ) - (50) * a ^ (5:ℕ) * t ^ (3:ℕ) - (22) * a ^ (5:ℕ) * t ^ (2:ℕ) - (4) * a ^ (5:ℕ) * t + (2) * a ^ (4:ℕ) * t ^ (7:ℕ) + (13) * a ^ (4:ℕ) * t ^ (6:ℕ) + (37) * a ^ (4:ℕ) * t ^ (5:ℕ) + (61) * a ^ (4:ℕ) * t ^ (4:ℕ) + (61) * a ^ (4:ℕ) * t ^ (3:ℕ) + (34) * a ^ (4:ℕ) * t ^ (2:ℕ) + (8) * a ^ (4:ℕ) * t + a ^ (3:ℕ) * t ^ (6:ℕ) + (11) * a ^ (3:ℕ) * t ^ (5:ℕ) + (27) * a ^ (3:ℕ) * t ^ (4:ℕ) + (21) * a ^ (3:ℕ) * t ^ (3:ℕ) - (4) * a ^ (3:ℕ) * t + (9) * a ^ (2:ℕ) * t ^ (5:ℕ) + (9) * a ^ (2:ℕ) * t ^ (4:ℕ) - (12) * a ^ (2:ℕ) * t ^ (3:ℕ) - (12) * a ^ (2:ℕ) * t ^ (2:ℕ) + (3) * a * t ^ (5:ℕ) - (3) * a * t ^ (4:ℕ) - (8) * a * t ^ (3:ℕ) ≤ 0 := by
  have hN : 0 ≤ (2) * a ^ (5:ℕ) * t ^ (7:ℕ) + (14) * a ^ (5:ℕ) * t ^ (6:ℕ) + (40) * a ^ (5:ℕ) * t ^ (5:ℕ) + (60) * a ^ (5:ℕ) * t ^ (4:ℕ) + (50) * a ^ (5:ℕ) * t ^ (3:ℕ) + (22) * a ^ (5:ℕ) * t ^ (2:ℕ) + (4) * a ^ (5:ℕ) * t - (2) * a ^ (4:ℕ) * t ^ (7:ℕ) - (13) * a ^ (4:ℕ) * t ^ (6:ℕ) - (37) * a ^ (4:ℕ) * t ^ (5:ℕ) - (61) * a ^ (4:ℕ) * t ^ (4:ℕ) - (61) * a ^ (4:ℕ) * t ^ (3:ℕ) - (34) * a ^ (4:ℕ) * t ^ (2:ℕ) - (8) * a ^ (4:ℕ) * t - a ^ (3:ℕ) * t ^ (6:ℕ) - (11) * a ^ (3:ℕ) * t ^ (5:ℕ) - (27) * a ^ (3:ℕ) * t ^ (4:ℕ) - (21) * a ^ (3:ℕ) * t ^ (3:ℕ) + (4) * a ^ (3:ℕ) * t - (9) * a ^ (2:ℕ) * t ^ (5:ℕ) - (9) * a ^ (2:ℕ) * t ^ (4:ℕ) + (12) * a ^ (2:ℕ) * t ^ (3:ℕ) + (12) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a * t ^ (5:ℕ) + (3) * a * t ^ (4:ℕ) + (8) * a * t ^ (3:ℕ) := fs_SA0_N0 ha0 ha1 ht0.le ht1
  linarith only [hN, ht0]

/-- The `A0` value, linear in the two logarithms, is nonpositive. -/
theorem fs_SA0_bound {a t : ℝ} (ha0 : 0 ≤ a) (ha1 : a ≤ 1 / 7) (ht0 : 0 < t) (ht1 : t ≤ 1 / 4) :
    ((1 / 2) * a ^ (4:ℕ) * t ^ (2:ℕ) + a ^ (4:ℕ) * t + (1 / 2) * a ^ (4:ℕ) + (3 / 2) * a ^ (3:ℕ) * t ^ (2:ℕ) + (5 / 2) * a ^ (3:ℕ) * t + a ^ (3:ℕ) + (3 / 2) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3 / 2) * a ^ (2:ℕ) + (1 / 2) * a * t ^ (2:ℕ) - (3 / 2) * a * t) / ((1 - a)) + (-a ^ (3:ℕ) * t ^ (2:ℕ) - (2) * a ^ (3:ℕ) * t - a ^ (3:ℕ) - (3) * a ^ (2:ℕ) * t ^ (2:ℕ) - (3) * a ^ (2:ℕ) * t + (3) * a * t + a) / ((1 - a) * t) * Real.log (1 + t) +
      (-a * t - a + (1)) / (1) * Real.log (1 - a * (1 + t)) ≤ 0 := by
  have hb : 0 < 1 - a := by linarith
