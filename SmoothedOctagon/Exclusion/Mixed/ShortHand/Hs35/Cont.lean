/-- Corner discriminant `b2_34_3`: `P_b2_34_3` is the cleared discriminant. -/
private theorem disc_b2_34_3 {a S : ℝ} (ha : 11 / 10 ≤ a) (hS : 3 ≤ S) (hS2 : S ≤ 19 / 6) :
    0 < disc2 a S (3 / 4) 3 := by
  have ha0 : 0 < a := by linarith
  have hk : 0 < 5 * a - 1 := by linarith
  have hS0 : 0 < S := by linarith
  have key : disc2 a S (3 / 4) 3 * (S ^ 2 * a ^ 4 * (5 * a - 1) ^ 2) =
      1 / 21609 * P_b2_34_3 a S := by
    unfold disc2 qDisc t2c0 t2c1 t2c2 hs35cK hs35cH hs35cB hs35cA P_b2_34_3
    field_simp
    ring
  have h : 0 < 1 / 21609 * P_b2_34_3 a S := mul_pos (by norm_num) (P_b2_34_3_pos ha hS hS2)
  rw [← key] at h
  exact (mul_pos_iff_of_pos_right (by positivity)).1 h

