      X + 1 - p * a1 + log (p / r) + qm * (p * a2 + 1 / p - 1 - a3) < 0 by
    obtain ⟨qm, hqm, hm⟩ := hm
    rcases le_or_gt 0 (p * a2 + 1 / p - 1 - a3) with h | h
    · have := mul_nonneg (sub_nonneg.2 hqm) h
      linarith
    · have := mul_nonpos_of_nonneg_of_nonpos hq h.le
      linarith
