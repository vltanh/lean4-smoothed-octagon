/-- `W = (βx - α)m`, `m = (8x² + 8x - 3)α + (3x² - 8x - 8)β`. -/
private noncomputable def s5W (x be al : ℝ) : ℝ :=
  (be * x - al) * ((8 * x ^ 2 + 8 * x - 3) * al + (3 * x ^ 2 - 8 * x - 8) * be)

/-- `V = α²W + 3K_xK_AQ₀(x - 1)`. -/
private noncomputable def s5V (x be al : ℝ) : ℝ :=
  al ^ 2 * s5W x be al +
    3 * (x ^ 2 + x + 1) * (al ^ 2 + al * be + be ^ 2) * (2 * be * x - x - al * be) * (x - 1)

