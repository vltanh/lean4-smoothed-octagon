  unfold hh0CTc0 hh0CTc1 hh0CTc2 hh0CTc3 hh0CTc4 hh0CTe4_0 hh0CTe4_1 hh0CTe4_2 hh0CTe4_3 hh0CTe4_4 hh0CTe4_5 hh0CTe4_6 hh0CTe4_7 hh0CTn0_0 hh0CTn0_1 hh0CTn0_2 hh0CTn0_3 hh0CTn0_4 hh0CTn0_5 hh0CTn0_6 hh0CTn1_0 hh0CTn1_1 hh0CTn1_2 hh0CTn1_3 hh0CTn1_4 hh0CTn1_5 hh0CTn1_6 hh0CTn2_0 hh0CTn2_1 hh0CTn2_2 hh0CTn2_3 hh0CTn2_4 hh0CTn2_5 hh0CTn3_0 hh0CTn3_1 hh0CTn3_2 hh0CTn3_3 hh0CTn3_4 hh0CTn4_0 hh0CTn4_1 hh0CTn4_2 hh0CTn4_3
  ring

private theorem hh0CT_pos (X a b : ℝ) (hX : 0 ≤ X) (ha : 0 ≤ a) (ha' : 12 * a ≤ (5 * X + 4))
    (hb : 0 ≤ b) (hb' : (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) * b ≤ (X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) :
    0 < hh0CTc0 X a + hh0CTc1 X a * b + hh0CTc2 X a * b ^ (2 : ℕ) + hh0CTc3 X a * b ^ (3 : ℕ) + hh0CTc4 X a * b ^ (4 : ℕ) :=
  hh0_bern4 hb hb' (by positivity) (hh0CT_L1_0 X a hX ha ha') (hh0CT_L1_1 X a hX ha ha') (hh0CT_L1_2 X a hX ha ha') (hh0CT_L1_3 X a hX ha ha') (hh0CT_L1_4 X a hX ha ha')

private theorem hh0CT_st1 (x al be : ℝ) : hh0CTN x al be = hh0CTM0 x al + hh0CTM1 x al * (be - x) + hh0CTM2 x al * (be - x) ^ (2 : ℕ) + hh0CTM3 x al * (be - x) ^ (3 : ℕ) + hh0CTM4 x al * (be - x) ^ (4 : ℕ) := by
  unfold hh0CTN hh0CTM0 hh0CTM1 hh0CTM2 hh0CTM3 hh0CTM4
  ring

private theorem hh0CT_st2_0 (X a : ℝ) : hh0CTM0 (X + 12 / 5) (a + 1) = hh0CTc0 X a := by
  unfold hh0CTM0 hh0CTc0 hh0CTn0_0 hh0CTn0_1 hh0CTn0_2 hh0CTn0_3 hh0CTn0_4 hh0CTn0_5 hh0CTn0_6
  ring

private theorem hh0CT_st2_1 (X a : ℝ) : hh0CTM1 (X + 12 / 5) (a + 1) = hh0CTc1 X a := by
  unfold hh0CTM1 hh0CTc1 hh0CTn1_0 hh0CTn1_1 hh0CTn1_2 hh0CTn1_3 hh0CTn1_4 hh0CTn1_5 hh0CTn1_6
  ring

private theorem hh0CT_st2_2 (X a : ℝ) : hh0CTM2 (X + 12 / 5) (a + 1) = hh0CTc2 X a := by
  unfold hh0CTM2 hh0CTc2 hh0CTn2_0 hh0CTn2_1 hh0CTn2_2 hh0CTn2_3 hh0CTn2_4 hh0CTn2_5
  ring

private theorem hh0CT_st2_3 (X a : ℝ) : hh0CTM3 (X + 12 / 5) (a + 1) = hh0CTc3 X a := by
  unfold hh0CTM3 hh0CTc3 hh0CTn3_0 hh0CTn3_1 hh0CTn3_2 hh0CTn3_3 hh0CTn3_4
  ring

private theorem hh0CT_st2_4 (X a : ℝ) : hh0CTM4 (X + 12 / 5) (a + 1) = hh0CTc4 X a := by
  unfold hh0CTM4 hh0CTc4 hh0CTn4_0 hh0CTn4_1 hh0CTn4_2 hh0CTn4_3
  ring

private theorem hh0CTN_eq (X a b : ℝ) :
    hh0CTN (X + 12 / 5) (a + 1) (X + 12 / 5 + b) = hh0CTc0 X a + hh0CTc1 X a * b + hh0CTc2 X a * b ^ (2 : ℕ) + hh0CTc3 X a * b ^ (3 : ℕ) + hh0CTc4 X a * b ^ (4 : ℕ) := by
  rw [hh0CT_st1, hh0CT_st2_0, hh0CT_st2_1, hh0CT_st2_2, hh0CT_st2_3, hh0CT_st2_4]
  ring

private theorem hh0CT_Npos {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : 1 ≤ al) (hal' : al ≤ (5 * x + 4) / 12)
    (hxb : x ≤ be) (hb : (4 * x ^ 2 + 11 * x + 1) * (be - x) ≤ x * (7 * x + 1) * (al - 1)) :
    0 < hh0CTN x al be := by
  obtain ⟨X, rfl⟩ : ∃ X, x = X + 12 / 5 := ⟨x - 12 / 5, by ring⟩
  obtain ⟨a, rfl⟩ : ∃ a, al = a + 1 := ⟨al - (1), by ring⟩
  obtain ⟨b, rfl⟩ : ∃ b, be = X + 12 / 5 + b := ⟨be - (X + 12 / 5), by ring⟩
  rw [hh0CTN_eq]
  refine hh0CT_pos X a b (by linarith) (by linarith) (by linarith) (by linarith) ?_
  have h := hb
  ring_nf at h ⊢
  linarith

private theorem hh0CT_eq {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : 1 ≤ al) (hxb : x ≤ be) :
    hsF x be al (hsUhat x be) (hsQc x al) (hsRA al be / hsQc x al) 0 (1 / 2) =
      -hh0CTN x al be / (8 * al * (al + be) * (be - 1) * (x + 1) * (35 * x + 13) * (al ^ 2 + x ^ 2 + 2 * x) ^ 2) := by
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hb1 : 0 < be - 1 := by linarith
  have hab : 0 < al + be := by linarith
  have hH : 0 < al ^ 2 + x ^ 2 + 2 * x := by positivity
  have hH' : 0 < x * (x + 2) + al ^ 2 := by positivity
  unfold hsF hsWs hsELs hsA1 hsA2 hsA3 hsE0 hsDg hsRA hsQc hsUhat hh0CTN
  rw [eq_div_iff (by positivity)]
  field_simp
  ring

/-- **The central face, `τ = T` test `F(T, 0)`** is negative (`hsF = -hh0CTN/Den`, nested Bernstein certificate of
`hh0CTN > 0`). -/
theorem hh0CT_neg {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : 1 ≤ al) (hal' : al ≤ (5 * x + 4) / 12)
    (hxb : x ≤ be) (hb : be ≤ x + x * (7 * x + 1) * (al - 1) / (4 * x ^ 2 + 11 * x + 1)) :
    hsF x be al (hsUhat x be) (hsQc x al) (hsRA al be / hsQc x al) 0 (1 / 2) < 0 := by
  have hal1 : 1 ≤ al := hal
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hb1 : 0 < be - 1 := by linarith
  have hab : 0 < al + be := by linarith
  have hRp : 0 < 4 * x ^ 2 + 11 * x + 1 := by positivity
  have hR : (4 * x ^ 2 + 11 * x + 1) * (be - x) ≤ x * (7 * x + 1) * (al - 1) := by
    have h := hb
    rw [← sub_le_iff_le_add', le_div_iff₀ hRp] at h
    linarith
  rw [hh0CT_eq hx hal1 hxb]
  have hN := hh0CT_Npos hx hal hal' hxb hR
  have hD : 0 < 8 * al * (al + be) * (be - 1) * (x + 1) * (35 * x + 13) * (al ^ 2 + x ^ 2 + 2 * x) ^ 2 := by positivity
  exact div_neg_of_neg_of_pos (by linarith) hD

end SmoothedOctagon
