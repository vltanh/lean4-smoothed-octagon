/-- Bernstein positivity of degree 5 on `[0, g]`, with abstract coefficients. -/
theorem hh46Bern0g5 {g y c0 c1 c2 c3 c4 c5 : ℝ} (h0 : 0 ≤ y) (h1 : y ≤ g) (hg : 0 < g)
    (hb0 : 0 < c0)
    (hb1 : 0 < 5 * c0 + c1 * g)
    (hb2 : 0 < 10 * c0 + 4 * c1 * g + c2 * g ^ (2 : ℕ))
    (hb3 : 0 < 10 * c0 + 6 * c1 * g + 3 * c2 * g ^ (2 : ℕ) + c3 * g ^ (3 : ℕ))
    (hb4 : 0 < 5 * c0 + 4 * c1 * g + 3 * c2 * g ^ (2 : ℕ) + 2 * c3 * g ^ (3 : ℕ) + c4 * g ^ (4 : ℕ))
    (hb5 : 0 < c0 + c1 * g + c2 * g ^ (2 : ℕ) + c3 * g ^ (3 : ℕ) + c4 * g ^ (4 : ℕ) + c5 * g ^ (5 : ℕ)) :
    0 < c0 + c1 * y + c2 * y ^ (2 : ℕ) + c3 * y ^ (3 : ℕ) + c4 * y ^ (4 : ℕ) + c5 * y ^ (5 : ℕ) := by
  have hpos := hh46BernPos5 (a := y) (b := g - y) h0 (by linarith) (by linarith) hb0 hb1 hb2 hb3 hb4 hb5
  have e : g ^ (5 : ℕ) * (c0 + c1 * y + c2 * y ^ (2 : ℕ) + c3 * y ^ (3 : ℕ) + c4 * y ^ (4 : ℕ) + c5 * y ^ (5 : ℕ)) = (c0) * (g - y) ^ (5 : ℕ) + (5 * c0 + c1 * g) * y * (g - y) ^ (4 : ℕ) + (10 * c0 + 4 * c1 * g + c2 * g ^ (2 : ℕ)) * y ^ (2 : ℕ) * (g - y) ^ (3 : ℕ) + (10 * c0 + 6 * c1 * g + 3 * c2 * g ^ (2 : ℕ) + c3 * g ^ (3 : ℕ)) * y ^ (3 : ℕ) * (g - y) ^ (2 : ℕ) + (5 * c0 + 4 * c1 * g + 3 * c2 * g ^ (2 : ℕ) + 2 * c3 * g ^ (3 : ℕ) + c4 * g ^ (4 : ℕ)) * y ^ (4 : ℕ) * (g - y) + (c0 + c1 * g + c2 * g ^ (2 : ℕ) + c3 * g ^ (3 : ℕ) + c4 * g ^ (4 : ℕ) + c5 * g ^ (5 : ℕ)) * y ^ (5 : ℕ) := by ring
  rw [← e] at hpos
  exact pos_of_mul_pos_right hpos (by positivity)

