/-!
# Heavy H-S leaves: generic Bernstein lemmas (degrees 5-10, 19)

Generic Bernstein positivity with abstract coefficients (generated by
`scripts/certificates/short-hand/hh46/bern_lemmas.py`):

* `hh46BernPos{n}`: a Bernstein form with positive coefficients is positive;
* `hh46Bern0g{n}`: `∑ cᵢ yⁱ > 0` on `[0, g]` when its Bernstein coefficients
  `∑_{i ≤ k} C(n - i, k - i) cᵢ gⁱ` are positive (one `ring` identity per degree).

Degrees: 5, 6, 7, 8, 9, 10, 19 (degrees 14 and 24 are in `S6Bern`).
-/

@[expose] public section

namespace SmoothedOctagon

/-- A Bernstein form of degree 5 with positive coefficients is positive. -/
theorem hh46BernPos5 {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : 0 < a + b) {c0 c1 c2 c3 c4 c5 : ℝ}
    (h0 : 0 < c0) (h1 : 0 < c1) (h2 : 0 < c2) (h3 : 0 < c3) (h4 : 0 < c4) (h5 : 0 < c5) :
    0 < c0 * b ^ (5 : ℕ) + c1 * a * b ^ (4 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (3 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (2 : ℕ) + c4 * a ^ (4 : ℕ) * b + c5 * a ^ (5 : ℕ) := by
  rcases lt_or_ge 0 a with h | h
  · have h' : 0 < c5 * a ^ (5 : ℕ) := by positivity
    have h'' : 0 ≤ c0 * b ^ (5 : ℕ) + c1 * a * b ^ (4 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (3 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (2 : ℕ) + c4 * a ^ (4 : ℕ) * b := by positivity
    linarith
  · have hb' : 0 < b := by linarith
    have h' : 0 < c0 * b ^ (5 : ℕ) := by positivity
    have h'' : 0 ≤ c1 * a * b ^ (4 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (3 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (2 : ℕ) + c4 * a ^ (4 : ℕ) * b + c5 * a ^ (5 : ℕ) := by positivity
    linarith

