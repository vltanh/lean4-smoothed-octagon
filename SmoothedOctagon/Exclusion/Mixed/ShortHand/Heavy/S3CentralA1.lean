set_option maxRecDepth 20000 in
theorem hh3_c1_Q (x t c : ℝ) :
    hh3HorD (hh3C1Ns x c) t * hh3CE x t - hh3Hor (hh3C1Ns x c) t * hh3C1ED x t +
      hh3Hor (hh3C1Ds x) t * hh3CEL x t = -hh3C1P x t c := by
  simp only [hh3C1Ns, hh3C1Ds, hh3Hor, hh3HorD, hh3CE, hh3C1ED, hh3CEL, hh3C1P]
  ring

