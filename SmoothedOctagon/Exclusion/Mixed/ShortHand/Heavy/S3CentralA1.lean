      hh3C1S x t / (9 * t * (5 * t - 1) * (5 * x + 12) ^ 2 * (t ^ 2 + x ^ 2 + 2 * x) ^ 2 * (40 * t * x + 36 * t + 15 * x ^ 2 + 11 * x)) := by
