private theorem hh0C2N_eq (X a b : ℝ) :
    hh0C2N (X + 12 / 5) (a + 1) (X + 12 / 5 + b) = hh0C2c0 X a + hh0C2c1 X a * b + hh0C2c2 X a * b ^ (2 : ℕ) + hh0C2c3 X a * b ^ (3 : ℕ) + hh0C2c4 X a * b ^ (4 : ℕ) := by
  rw [hh0C2_st1, hh0C2_st2_0, hh0C2_st2_1, hh0C2_st2_2, hh0C2_st2_3, hh0C2_st2_4]
