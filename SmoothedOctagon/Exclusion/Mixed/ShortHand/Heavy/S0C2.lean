private theorem hh0C2_L1_4 (X a : ℝ) (hX : 0 ≤ X) (ha : 0 ≤ a) (ha' : 12 * a ≤ (5 * X + 4)) :
    0 < hh0C2c0 X a * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (4 : ℕ) + hh0C2c1 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (3 : ℕ) + hh0C2c2 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (2 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (2 : ℕ) + hh0C2c3 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (3 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) + hh0C2c4 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (4 : ℕ) := by
