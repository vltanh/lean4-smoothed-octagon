private theorem hh0C2_pos (X a b : ℝ) (hX : 0 ≤ X) (ha : 0 ≤ a) (ha' : 12 * a ≤ (5 * X + 4))
    (hb : 0 ≤ b) (hb' : (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) * b ≤ (X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) :
    0 < hh0C2c0 X a + hh0C2c1 X a * b + hh0C2c2 X a * b ^ (2 : ℕ) + hh0C2c3 X a * b ^ (3 : ℕ) + hh0C2c4 X a * b ^ (4 : ℕ) :=
  hh0_bern4 hb hb' (by positivity) (hh0C2_L1_0 X a hX ha ha') (hh0C2_L1_1 X a hX ha ha') (hh0C2_L1_2 X a hX ha ha') (hh0C2_L1_3 X a hX ha ha') (hh0C2_L1_4 X a hX ha ha')

private theorem hh0C2_st1 (x al be : ℝ) : hh0C2N x al be = hh0C2M0 x al + hh0C2M1 x al * (be - x) + hh0C2M2 x al * (be - x) ^ (2 : ℕ) + hh0C2M3 x al * (be - x) ^ (3 : ℕ) + hh0C2M4 x al * (be - x) ^ (4 : ℕ) := by
  unfold hh0C2N hh0C2M0 hh0C2M1 hh0C2M2 hh0C2M3 hh0C2M4
