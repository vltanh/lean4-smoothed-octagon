    0 < 15 * hh0OTc0 X a * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (4 : ℕ) + 10 * hh0OTc1 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (3 : ℕ) + 6 * hh0OTc2 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (2 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (2 : ℕ) + 3 * hh0OTc3 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (3 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) + hh0OTc4 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (4 : ℕ) := by
  convert hh0OT_B4 X (a - ((22 * (X + 12 / 5) + 20) / 55 - 1)) hX ha ha' using 1
  unfold hh0OTc0 hh0OTc1 hh0OTc2 hh0OTc3 hh0OTc4 hh0OTe4_0 hh0OTe4_1 hh0OTe4_2 hh0OTe4_3 hh0OTe4_4 hh0OTe4_5 hh0OTe4_6 hh0OTe4_7 hh0OTe4_8 hh0OTn0_0 hh0OTn0_1 hh0OTn0_2 hh0OTn0_3 hh0OTn0_4 hh0OTn0_5 hh0OTn1_0 hh0OTn1_1 hh0OTn1_2 hh0OTn1_3 hh0OTn1_4 hh0OTn1_5 hh0OTn2_0 hh0OTn2_1 hh0OTn2_2 hh0OTn2_3 hh0OTn2_4 hh0OTn3_0 hh0OTn3_1 hh0OTn3_2 hh0OTn3_3 hh0OTn3_4 hh0OTn3_5 hh0OTn4_0 hh0OTn4_1 hh0OTn4_2 hh0OTn4_3 hh0OTn4_4
  ring

