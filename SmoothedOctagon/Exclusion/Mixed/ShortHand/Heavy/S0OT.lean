    0 < hh0OTc0 X a * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (6 : ℕ) + hh0OTc1 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (5 : ℕ) + hh0OTc2 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (2 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (4 : ℕ) + hh0OTc3 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (3 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (3 : ℕ) + hh0OTc4 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (4 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) ^ (2 : ℕ) + hh0OTc5 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (5 : ℕ) * (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) + hh0OTc6 X a * ((X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) ^ (6 : ℕ) := by
