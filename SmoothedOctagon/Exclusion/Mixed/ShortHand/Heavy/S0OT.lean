private theorem hh0OT_pos (X a b : ℝ) (hX : 0 ≤ X) (ha : 0 ≤ (a - ((22 * (X + 12 / 5) + 20) / 55 - 1))) (ha' : 55 * (a - ((22 * (X + 12 / 5) + 20) / 55 - 1)) ≤ (33 * X + 296 / 5))
    (hb : 0 ≤ b) (hb' : (4 * (X + 12 / 5) ^ (2 : ℕ) + 11 * (X + 12 / 5) + 1) * b ≤ (X + 12 / 5) * (7 * (X + 12 / 5) + 1) * (a + 1 - 1)) :
    0 < hh0OTc0 X a + hh0OTc1 X a * b + hh0OTc2 X a * b ^ (2 : ℕ) + hh0OTc3 X a * b ^ (3 : ℕ) + hh0OTc4 X a * b ^ (4 : ℕ) + hh0OTc5 X a * b ^ (5 : ℕ) + hh0OTc6 X a * b ^ (6 : ℕ) :=
  hh0_bern6 hb hb' (by positivity) (hh0OT_L1_0 X a hX ha ha') (hh0OT_L1_1 X a hX ha ha') (hh0OT_L1_2 X a hX ha ha') (hh0OT_L1_3 X a hX ha ha') (hh0OT_L1_4 X a hX ha ha') (hh0OT_L1_5 X a hX ha ha') (hh0OT_L1_6 X a hX ha ha')

private theorem hh0OT_st1 (x al be : ℝ) : hh0OTN x al be = hh0OTM0 x al + hh0OTM1 x al * (be - x) + hh0OTM2 x al * (be - x) ^ (2 : ℕ) + hh0OTM3 x al * (be - x) ^ (3 : ℕ) + hh0OTM4 x al * (be - x) ^ (4 : ℕ) + hh0OTM5 x al * (be - x) ^ (5 : ℕ) + hh0OTM6 x al * (be - x) ^ (6 : ℕ) := by
  unfold hh0OTN hh0OTM0 hh0OTM1 hh0OTM2 hh0OTM3 hh0OTM4 hh0OTM5 hh0OTM6
  ring

