private theorem hh0OTN_eq (X a b : ℝ) :
    hh0OTN (X + 12 / 5) (a + 1) (X + 12 / 5 + b) = hh0OTc0 X a + hh0OTc1 X a * b + hh0OTc2 X a * b ^ (2 : ℕ) + hh0OTc3 X a * b ^ (3 : ℕ) + hh0OTc4 X a * b ^ (4 : ℕ) + hh0OTc5 X a * b ^ (5 : ℕ) + hh0OTc6 X a * b ^ (6 : ℕ) := by
  rw [hh0OT_st1, hh0OT_st2_0, hh0OT_st2_1, hh0OT_st2_2, hh0OT_st2_3, hh0OT_st2_4, hh0OT_st2_5, hh0OT_st2_6]
  ring

private theorem hh0OT_Npos {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : (22 * x + 20) / 55 ≤ al) (hal' : al ≤ x)
    (hxb : x ≤ be) (hb : (4 * x ^ 2 + 11 * x + 1) * (be - x) ≤ x * (7 * x + 1) * (al - 1)) :
    0 < hh0OTN x al be := by
  obtain ⟨X, rfl⟩ : ∃ X, x = X + 12 / 5 := ⟨x - 12 / 5, by ring⟩
  obtain ⟨a, rfl⟩ : ∃ a, al = a + 1 := ⟨al - (1), by ring⟩
  obtain ⟨b, rfl⟩ : ∃ b, be = X + 12 / 5 + b := ⟨be - (X + 12 / 5), by ring⟩
  rw [hh0OTN_eq]
  refine hh0OT_pos X a b (by linarith) (by linarith) (by linarith) (by linarith) ?_
  have h := hb
  ring_nf at h ⊢
  linarith

private theorem hh0OT_eq {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : 1 ≤ al) (hxb : x ≤ be) :
    hsF x be al (hsUbar x be) (1 / 7) (7 * hsRA al be) 0 (1 / 2) =
      -hh0OTN x al be / (4704 * al ^ 4 * x ^ 2 * (al + be) * (be - 1) * (x + 1) * (35 * x + 13)) := by
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hb1 : 0 < be - 1 := by linarith
  have hab : 0 < al + be := by linarith
  have hH : 0 < al ^ 2 + x ^ 2 + 2 * x := by positivity
  have hH' : 0 < x * (x + 2) + al ^ 2 := by positivity
  unfold hsF hsWs hsELs hsA1 hsA2 hsA3 hsE0 hsDg hsRA hsUbar hh0OTN
  rw [eq_div_iff (by positivity)]
  field_simp
  ring

/-- **The outer face, `τ = T` test `F(T, 0)`** is negative (`hsF = -hh0OTN/Den`, nested Bernstein certificate of
`hh0OTN > 0`). -/
theorem hh0OT_neg {x al be : ℝ} (hx : 12 / 5 ≤ x) (hal : (22 * x + 20) / 55 ≤ al) (hax : al ≤ x)
    (hb : x + 4 * x * (al - 1) / (5 * x + 4) ≤ be)
    (hb' : be ≤ x + x * (7 * x + 1) * (al - 1) / (4 * x ^ 2 + 11 * x + 1)) :
    hsF x be al (hsUbar x be) (1 / 7) (7 * hsRA al be) 0 (1 / 2) < 0 := by
  have hal1 : 1 ≤ al := by linarith
  have hxb : x ≤ be := by
    have : 0 ≤ 4 * x * (al - 1) / (5 * x + 4) := by
      apply div_nonneg <;> nlinarith
    linarith
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hb1 : 0 < be - 1 := by linarith
  have hab : 0 < al + be := by linarith
  have hRp : 0 < 4 * x ^ 2 + 11 * x + 1 := by positivity
  have hR : (4 * x ^ 2 + 11 * x + 1) * (be - x) ≤ x * (7 * x + 1) * (al - 1) := by
    have h := hb'
    rw [← sub_le_iff_le_add', le_div_iff₀ hRp] at h
    linarith
  rw [hh0OT_eq hx hal1 hxb]
  have hN := hh0OT_Npos hx hal hax hxb hR
  have hD : 0 < 4704 * al ^ 4 * x ^ 2 * (al + be) * (be - 1) * (x + 1) * (35 * x + 13) := by positivity
  exact div_neg_of_neg_of_pos (by linarith) hD

