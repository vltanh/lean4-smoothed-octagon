    hh3HorD (hh3C0Ns x c) t * hh3CE x t - hh3Hor (hh3C0Ns x c) t * hh3C0ED x t +
      hh3Hor (hh3C0Ds x) t * hh3CEL x t = -hh3C0P x t c := by
  simp only [hh3C0Ns, hh3C0Ds, hh3Hor, hh3HorD, hh3CE, hh3C0ED, hh3CEL, hh3C0P]
  ring

set_option maxRecDepth 20000 in
theorem hh3_c0_P_aff (x t c : ℝ) :
    hh3C0P x t c = 20 * ((4 / 5 - c) * hh3C0P x t (3 / 4) + (c - 3 / 4) * hh3C0P x t (4 / 5)) := by
  unfold hh3C0P
  ring

set_option maxRecDepth 20000 in
/-- The incoming-norm slope of `F_0` on the central path, cleared. -/
theorem hh3_c0_slope_eq (x t : ℝ) (hx : 1 < x) (ht : 1 < t) :
    hh3Slope x (hs3b x t) t (hsQc x t) (2 + 4 * (4 - 3 * (2 * hsQc x t / hsRA t (hs3b x t))) / (5 * t - 1)) =
      hh3C0S x t / (9 * t * (5 * t - 1) * (5 * x + 12) ^ 3 * (t ^ 2 + x ^ 2 + 2 * x) ^ 3) := by
  unfold hh3Slope hh3C0S hsDg hsRA hs3b hsQc
  have h1 : 15 * x + 36 ≠ 0 := by positivity
  have h1x : x * 15 + 36 ≠ 0 := by positivity
  have h2 : x * (x + 2) + t ^ 2 ≠ 0 := by positivity
  have h2' : t ^ 2 + x ^ 2 + 2 * x ≠ 0 := by positivity
  have h3 : 5 * t - 1 ≠ 0 := by linarith
  have h3x : t * 5 - 1 ≠ 0 := by linarith
  have h5 : 5 * x + 12 ≠ 0 := by positivity
  have h6 : 40 * t * x + 36 * t + 15 * x ^ 2 + 11 * x ≠ 0 := by positivity
  have h7 : t * (15 * x + 36) + (x * (15 * x + 36) + 25 * x * (t - 1)) ≠ 0 := by nlinarith
  have h9 : t ≠ 0 := by positivity
  field_simp
  ring

end SmoothedOctagon
