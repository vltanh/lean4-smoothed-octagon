/-- `k_Φ`: lower bound of the fixed-`u` `β`-quotient of `Φ`. -/
noncomputable def hh46S4kPhi (x al u : ℝ) : ℝ :=
  4 * (x - al) * (u * (x * (x + 2) + al ^ 2) - 2 * hsDg x x al * u + hh46S4P x u) / (x * (x + 2) + al ^ 2) ^ 2 - (1 - u) / al + x / ((al + x) * (al + 20 / 19 * x))

/-- The `T`-term of the `Ψ` quotient at `β = x`. -/
noncomputable def hh46S4tE (x al u : ℝ) : ℝ :=
  2 * ((x * (x + 2) + al ^ 2) / (al * (al + x)) - 2) * (x - al) * (2 * hsDg x x al * u - hh46S4P x u) / (x * (x + 2) + al ^ 2) ^ 2

/-- `k_I = k_Φ - Σ(w_c(x) - 3/4)/(α(α + x)²) - tE`. -/
noncomputable def hh46S4kI (x al u : ℝ) : ℝ :=
  hh46S4kPhi x al u - (x * (x + 2) + al ^ 2) * (hh46S4Wc x x al u - 3 / 4) / (al * (al + x) ^ 2) - hh46S4tE x al u

/-- `k_II = k_Φ - tE`. -/
noncomputable def hh46S4kII (x al u : ℝ) : ℝ :=
  hh46S4kPhi x al u - hh46S4tE x al u

/-- `L_u`: lower bound of `∂_u Φ` (at `β = 20x/19`). -/
noncomputable def hh46S4Lu (x al u : ℝ) : ℝ :=
  (4 * (1 + x) ^ 2 * ((1 + x) ^ 2 - (1 + x) + 1) - 2 * hh46S4P x u * (1 + x) ^ 3) / (16 * x ^ 2 * (x + 2) ^ 2) - (2 * hsDg x (20 / 19 * x) al * (hsDg x (20 / 19 * x) al - (1 + x) ^ 3) / (x * (x + 2) + al ^ 2) ^ 2 + (al + 20 / 19 * x) / al - (2 * hsDg x (20 / 19 * x) al - (1 + x) ^ 3) / (x * (x + 2) + al ^ 2)) / 7

