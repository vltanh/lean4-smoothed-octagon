theorem hh46_s4_kPhi0_end {x al : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) (hal : 1 ≤ al) (hal2 : al ≤ 22 / 19) :
    (1 / 15) < hh46S4kPhi x al (757 / 1000) := by
  have hp := hh46_s4_kPhi0_poly hx hx2 hal hal2
  have hD : 0 < (x * (x + 2) + al ^ 2) ^ 2 * al * (al + x) * (al + 20 / 19 * x) := by
    have : 0 < al := by linarith
    have : 0 < x := by linarith
    positivity
  have hx0 : x ≠ 0 := by linarith
  have hx2' : x + 2 ≠ 0 := by linarith
  have hal0 : al ≠ 0 := by linarith
  have hA : al + x ≠ 0 := by linarith
  have hB : al + 20 / 19 * x ≠ 0 := by linarith
  have hS : x * (x + 2) + al ^ 2 ≠ 0 := by positivity
  have e : (hh46S4kPhi x al (757 / 1000) - (1 / 15)) * ((x * (x + 2) + al ^ 2) ^ 2 * al * (al + x) * (al + 20 / 19 * x)) = hh46S4AkPhi0_0 x + hh46S4AkPhi0_1 x * (al - 1) + hh46S4AkPhi0_2 x * (al - 1) ^ (2 : ℕ) + hh46S4AkPhi0_3 x * (al - 1) ^ (3 : ℕ) + hh46S4AkPhi0_4 x * (al - 1) ^ (4 : ℕ) + hh46S4AkPhi0_5 x * (al - 1) ^ (5 : ℕ) + hh46S4AkPhi0_6 x * (al - 1) ^ (6 : ℕ) + hh46S4AkPhi0_7 x * (al - 1) ^ (7 : ℕ) := by
    unfold hh46S4kPhi hh46S4P hsDg hh46S4AkPhi0_0 hh46S4AkPhi0_1 hh46S4AkPhi0_2 hh46S4AkPhi0_3 hh46S4AkPhi0_4 hh46S4AkPhi0_5 hh46S4AkPhi0_6 hh46S4AkPhi0_7
    field_simp
    ring
  have h3 : 0 < (hh46S4kPhi x al (757 / 1000) - (1 / 15)) * ((x * (x + 2) + al ^ 2) ^ 2 * al * (al + x) * (al + 20 / 19 * x)) := by rw [e]; exact hp
  have h4 := (pos_iff_pos_of_mul_pos h3).2 hD
  linarith

