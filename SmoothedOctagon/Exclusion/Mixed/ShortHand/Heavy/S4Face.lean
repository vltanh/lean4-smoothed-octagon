/-!
# Heavy leaf `hs4_floor_box`: the floor on the two faces

Face A (`η = 13/5`: `α = 1 + 13δ/5`, `β = x(1 + δ)`, `0 ≤ δ ≤ 1/19`) and face B (`δ = 1/19`:
`β = 20x/19`, `108/95 ≤ α ≤ 22/19`), with `u = ū(x, β)`: `Φ, Ψ > 1829/10000`. The logarithm is
replaced by the surrogate `hh46S4Ls` around the minimizing corners (`y₀ = 2524608/3353029` on face A,
`y₀ = 103488/134749` on face B, inventory HS-S4 R22), and the cleared surrogates are positive by the
Bernstein certificates (generated by `scripts/certificates/short-hand/hh46/s4face.py`).

## Main API

`hh46_s4_facePhiA`, `hh46_s4_facePsiA`, `hh46_s4_facePhiB`, `hh46_s4_facePsiB`.
-/

@[expose] public section

namespace SmoothedOctagon

/-- **`Phi` on face A** (surrogate certificate `hh46_s4_posPhiA`). -/
theorem hh46_s4_facePhiA {x v : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) (hv : 0 ≤ v) (hv2 : v ≤ (1 / 19)) :
    1829 / 10000 < hh46S4PhiC x (x * (1 + v)) (1 + 13 / 5 * v) (hsUbar x (x * (1 + v))) := by
  have hx0 : 0 < x := by linarith
  have hal : 0 < (1 + 13 / 5 * v) := by linarith
  have hbe : 0 < (x * (1 + v)) := by positivity
  have hdu : 0 < (-624 - 1680 * x + 624 * x * v + 624 * x ^ (2 : ℕ) + 2304 * x ^ (2 : ℕ) * v + 1680 * x ^ (3 : ℕ) + 1680 * x ^ (3 : ℕ) * v) := by
    have e : (-624 - 1680 * x + 624 * x * v + 624 * x ^ (2 : ℕ) + 2304 * x ^ (2 : ℕ) * v + 1680 * x ^ (3 : ℕ) + 1680 * x ^ (3 : ℕ) * v) = 48*(x + 1)*(35*x + 13)*(v*x + x - 1) := by ring
    rw [e]
    have : 0 < v * x + x - 1 := by nlinarith
    positivity
  have hu : hsUbar x (x * (1 + v)) = (-564 - 972 * x + 468 * x * v + 13 * x * v ^ (3 : ℕ) + 180 * x ^ (2 : ℕ) + 1728 * x ^ (2 : ℕ) * v + 48 * x ^ (2 : ℕ) * v ^ (3 : ℕ) + 1356 * x ^ (3 : ℕ) + 1260 * x ^ (3 : ℕ) * v + 35 * x ^ (3 : ℕ) * v ^ (3 : ℕ)) / (-624 - 1680 * x + 624 * x * v + 624 * x ^ (2 : ℕ) + 2304 * x ^ (2 : ℕ) * v + 1680 * x ^ (3 : ℕ) + 1680 * x ^ (3 : ℕ) * v) := by
    rw [eq_div_iff hdu.ne']
    unfold hsUbar
    have h1 : x + 1 ≠ 0 := by positivity
    have h2 : 35 * x + 13 ≠ 0 := by positivity
    have h3 : (x * (1 + v)) - 1 ≠ 0 := by nlinarith
    field_simp
    ring
  rw [hu]
  have hk : (0 : ℝ) < (3353029 / 2524608) := by norm_num
  have hL : Real.log (1 / (3353029 / 2524608)) ≤ (-29859585524772256150591371364021126 / 105221639105741353568377593684179355) := by
    have h := hh46_log_ge_quintic (z := (3353029 / 2524608)) (by norm_num)
    rw [one_div, Real.log_inv]
    norm_num at h ⊢
    linarith
  have h1 := hh46_s4_phiR_le (u := (-564 - 972 * x + 468 * x * v + 13 * x * v ^ (3 : ℕ) + 180 * x ^ (2 : ℕ) + 1728 * x ^ (2 : ℕ) * v + 48 * x ^ (2 : ℕ) * v ^ (3 : ℕ) + 1356 * x ^ (3 : ℕ) + 1260 * x ^ (3 : ℕ) * v + 35 * x ^ (3 : ℕ) * v ^ (3 : ℕ)) / (-624 - 1680 * x + 624 * x * v + 624 * x ^ (2 : ℕ) + 2304 * x ^ (2 : ℕ) * v + 1680 * x ^ (3 : ℕ) + 1680 * x ^ (3 : ℕ) * v)) hk hL hx0 hal hbe
  have h2 := hh46_s4_phiR_link (k := (3353029 / 2524608)) (L0 := (-29859585524772256150591371364021126 / 105221639105741353568377593684179355)) (nu := (-564 - 972 * x + 468 * x * v + 13 * x * v ^ (3 : ℕ) + 180 * x ^ (2 : ℕ) + 1728 * x ^ (2 : ℕ) * v + 48 * x ^ (2 : ℕ) * v ^ (3 : ℕ) + 1356 * x ^ (3 : ℕ) + 1260 * x ^ (3 : ℕ) * v + 35 * x ^ (3 : ℕ) * v ^ (3 : ℕ))) hx0 hal hbe hdu
  rw [hh46_s4_idPhiA x v] at h2
  have h4 := hh46_s4_posPhiA hx hx2 hv hv2
  have hM := hh46_s4_M_pos (X := x) (AL := (1 + 13 / 5 * v)) (A := (1 + 13 / 5 * v) + (x * (1 + v))) (Sg := x * (x + 2) + (1 + 13 / 5 * v) ^ 2)
    hx0 hal (by positivity) (by positivity) hdu
  have h5 := div_pos h4 hM
  rw [← h2] at h5
  linarith

