noncomputable def valuePolynomial (j y : ℝ) : Polynomial ℝ :=
  value Polynomial.X (Polynomial.C j) (Polynomial.C y)

theorem valuePolynomial_eval (h j y : ℝ) : (valuePolynomial j y).eval h = value h j y := by
  simp [valuePolynomial, value, row0, row1, row2, row3, row4, row5, row6]

noncomputable def slopePolynomial (j y : ℝ) : Polynomial ℝ :=
  slope Polynomial.X (Polynomial.C j) (Polynomial.C y)

theorem slopePolynomial_eval (h j y : ℝ) : (slopePolynomial j y).eval h = slope h j y := by
  simp [slopePolynomial, slope, slopeRow0, slopeRow1, slopeRow2, slopeRow3, slopeRow4, slopeRow5, slopeRow6]

noncomputable def slopeGapPolynomial (h y : ℝ) : Polynomial ℝ :=
  slope (Polynomial.C h) Polynomial.X (Polynomial.C y)

theorem slopeGapPolynomial_eval (h j y : ℝ) : (slopeGapPolynomial h y).eval j = slope h j y := by
  simp [slopeGapPolynomial, slope, slopeRow0, slopeRow1, slopeRow2, slopeRow3, slopeRow4, slopeRow5, slopeRow6]

theorem value_derivative (h j y : ℝ) :
    (valuePolynomial j y).derivative.eval h = -slope h j y := by
  simp only [valuePolynomial, value, Polynomial.derivative_add, Polynomial.derivative_mul,
    Polynomial.derivative_C, Polynomial.derivative_pow, mul_zero, add_zero,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_C,
    row0_derivative, row1_derivative, row2_derivative, row3_derivative, row4_derivative,
    row5_derivative, row6_derivative]
  unfold slope
  ring

end SmoothedOctagon.HighRatioScale
