def value {R : Type*} [CommRing R] (h j y : R) : R :=
  row0 h j +
    row1 h j * y ^ 1 +
    row2 h j * y ^ 2 +
    row3 h j * y ^ 3 +
    row4 h j * y ^ 4 +
    row5 h j * y ^ 5 +
    row6 h j * y ^ 6

def slope {R : Type*} [CommRing R] (h j y : R) : R :=
  slopeRow0 h j +
    slopeRow1 h j * y ^ 1 +
    slopeRow2 h j * y ^ 2 +
    slopeRow3 h j * y ^ 3 +
    slopeRow4 h j * y ^ 4 +
    slopeRow5 h j * y ^ 5 +
    slopeRow6 h j * y ^ 6

theorem row0_derivative (h j : ℝ) :
    ((row0 Polynomial.X (Polynomial.C j)).derivative).eval h = -slopeRow0 h j := by
  norm_num [row0, slopeRow0, Polynomial.derivative_mul, Polynomial.derivative_pow]
  ring

theorem row1_derivative (h j : ℝ) :
    ((row1 Polynomial.X (Polynomial.C j)).derivative).eval h = -slopeRow1 h j := by
  norm_num [row1, slopeRow1, Polynomial.derivative_mul, Polynomial.derivative_pow]
