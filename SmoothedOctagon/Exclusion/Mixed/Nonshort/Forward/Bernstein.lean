module

public import SmoothedOctagon.Exclusion.Mixed.Nonshort.Bernstein
public import Mathlib.Tactic.FieldSimp

/-!
# Case M2, forward successor: Bernstein positivity with abstract coefficients

* `nsfBern0g n`: a polynomial `∑ cᵢ yⁱ` of degree `n` is positive on `[0, g]` (`g > 0`) when its
  Bernstein coefficients `∑_{i ≤ k} C(n - i, k - i) cᵢ gⁱ` are positive;
* `nsfBernI n_lo_hi`: the same on a numeric interval `[lo, hi]` (the coefficients are explicit
  rational linear forms in the `cᵢ`).

The coefficients are abstract, so the nested certificates of the `*Signs` modules apply these lemmas
with polynomial coefficients without expanding them (generated by
`scripts/certificates/nonshort-forward/gen5.py`; each identity is checked by `ring`).
-/

@[expose] public section

namespace SmoothedOctagon

/-- A Bernstein form of degree 6 with positive coefficients is positive. -/
theorem nsfBernPos6 {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : 0 < a + b) {c0 c1 c2 c3 c4 c5 c6 : ℝ}
    (h0 : 0 < c0) (h1 : 0 < c1) (h2 : 0 < c2) (h3 : 0 < c3) (h4 : 0 < c4) (h5 : 0 < c5) (h6 : 0 < c6) :
    0 < c0 * b ^ (6 : ℕ) + c1 * a * b ^ (5 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (4 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (3 : ℕ) + c4 * a ^ (4 : ℕ) * b ^ (2 : ℕ) + c5 * a ^ (5 : ℕ) * b + c6 * a ^ (6 : ℕ) := by
  rcases lt_or_ge 0 a with h | h
  · have h' : 0 < c6 * a ^ (6 : ℕ) := by positivity
    have h'' : 0 ≤ c0 * b ^ (6 : ℕ) + c1 * a * b ^ (5 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (4 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (3 : ℕ) + c4 * a ^ (4 : ℕ) * b ^ (2 : ℕ) + c5 * a ^ (5 : ℕ) * b := by positivity
    linarith
  · have hb' : 0 < b := by linarith
    have h' : 0 < c0 * b ^ (6 : ℕ) := by positivity
    have h'' : 0 ≤ c1 * a * b ^ (5 : ℕ) + c2 * a ^ (2 : ℕ) * b ^ (4 : ℕ) + c3 * a ^ (3 : ℕ) * b ^ (3 : ℕ) + c4 * a ^ (4 : ℕ) * b ^ (2 : ℕ) + c5 * a ^ (5 : ℕ) * b + c6 * a ^ (6 : ℕ) := by positivity
    linarith

