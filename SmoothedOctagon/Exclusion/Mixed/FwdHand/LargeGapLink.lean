/-- The multiplier `α = 27/4 - 3u - 24y + 16j` (`MIXED_NONSHORT_LARGE_GAP_MULTIPLIER_SIGNS` (5)). -/
noncomputable def fhAlA (t x q : ℝ) : ℝ :=
  27 / 4 - 3 * (15 * (t - 1 / 3)) - 24 * (q - 1) + 16 * (2 * t + x - 1)

/-- The multiplier `M = 1/4 - u + 6y + 24j`. -/
noncomputable def fhMA (t x q : ℝ) : ℝ :=
  1 / 4 - 15 * (t - 1 / 3) + 6 * (q - 1) + 24 * (2 * t + x - 1)

