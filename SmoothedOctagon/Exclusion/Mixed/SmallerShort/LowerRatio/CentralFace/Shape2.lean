theorem lrcPy3s_pos {t s : ℝ} (ht0 : 0 ≤ t) (_ht1 : t ≤ (9 / 25 : ℝ)) (_hs0 : 0 ≤ s)
    (hs1 : s ≤ (31 / 200 : ℝ)) :
    (0 : ℝ) ≤ lrcPy3s t s := by
