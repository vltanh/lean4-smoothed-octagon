module

public import SmoothedOctagon.Exclusion.Mixed.SmallerShort.LowerRatio.CentralFace.Shape1

/-!
# Smaller-short window, lower ratio, central face: the curvature signs of the second test

Below the tangent chord `α_U` of the cap, `0 ≤ y″ ≤ 1/2` for
`y = 2α(α + β₊)/K`, and the curvature circuit `(N″V - NV″)V - 2V′(N′V - NV′) + V³(log y)″` is at
least `V³/700`. Each sign is a two-variable polynomial bounded termwise in
`x = 41/25 + t`, `α = α_U(x) - s`.

## Main API

* `lrcPy2s_pos`, `lrcPy3s_pos`, `lrcPcs_pos` with their unshifted forms and bridges.
-/

@[expose] public section

namespace SmoothedOctagon

/-- Numerator of `y″` along `β₊` (`y = 2αB/K`). -/
noncomputable def lrcPy2x (x a : ℝ) : ℝ :=
  92 / 13 * x ^ 4 - 12 * x ^ 3 * a + 368 / 13 * x ^ 3 - 276 / 13 * x ^ 2 * a ^ 2 - 192 / 13 * x ^ 2 * a + 368 / 13 * x ^ 2 + 4 * x * a ^ 3 - 552 / 13 * x * a ^ 2 + 240 / 13 * x * a - 40 / 13 * a ^ 3

/-- Its shift to the domain variables. -/
noncomputable def lrcPy2s (t s : ℝ) : ℝ :=
  -5676874183 / 3203226000 * t ^ 4 + 75959 / 2700 * t ^ 3 * s - 3147304525253 / 520524225000 * t ^ 3 - 3127 / 195 * t ^ 2 * s ^ 2 + 9933076193 / 49432500 * t ^ 2 * s + 39962689859113 / 2168850937500 * t ^ 2 - 4 * t * s ^ 3 - 6057932 / 63375 * t * s ^ 2 + 543102975263 / 1235812500 * t * s + 25865942291554357 / 325327640625000 * t - 1132 / 325 * s ^ 3 - 184265881 / 1584375 * s ^ 2 + 28282234231133 / 92685937500 * s + 1088381801136473231 / 16266382031250000

theorem lrcPy2s_pos {t s : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ (9 / 25 : ℝ)) (hs0 : 0 ≤ s) (hs1 : s ≤ (31 / 200 : ℝ)) :
    (0 : ℝ) ≤ lrcPy2s t s := by
  unfold lrcPy2s
  nlinarith [mul_le_mul_of_nonneg_left ht1 (by positivity : (0 : ℝ) ≤ t ^ 3),
    mul_le_mul_of_nonneg_left ht1 (by positivity : (0 : ℝ) ≤ t * s ^ 2),
    mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t * s ^ 2),
    mul_le_mul_of_nonneg_left ht1 (by positivity : (0 : ℝ) ≤ t ^ 2),
    mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t * s),
    mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ s ^ 2),
    mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ s),
    (by positivity : (0 : ℝ) ≤ t ^ 3 * s),
    (by positivity : (0 : ℝ) ≤ t ^ 2 * s),
    (by positivity : (0 : ℝ) ≤ t ^ 2),
    (by positivity : (0 : ℝ) ≤ t * s),
    (by positivity : (0 : ℝ) ≤ t),
    (by positivity : (0 : ℝ) ≤ s)]

theorem lrcPy2x_eq (x a : ℝ) : lrcPy2x x a = lrcPy2s (x - 41 / 25) ((1013 * x + 676) / 2340 - a) := by
  unfold lrcPy2x lrcPy2s
  ring

