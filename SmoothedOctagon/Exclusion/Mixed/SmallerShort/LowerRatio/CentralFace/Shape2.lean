  have q5 := (by positivity : (0 : ℝ) ≤ s ^ 6)
  have q6 := (by positivity : (0 : ℝ) ≤ t)
  have q7 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t)
