  have q14 := (by positivity : (0 : ℝ) ≤ t ^ 2 * s ^ 2)
  have q15 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t ^ 2 * s ^ 2)
  have q16 := (by positivity : (0 : ℝ) ≤ t ^ 2 * s ^ 4)
  have q17 := (by positivity : (0 : ℝ) ≤ t ^ 3)
  have q18 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t ^ 3)
  have q19 := (by positivity : (0 : ℝ) ≤ t ^ 3 * s ^ 2)
  have q20 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t ^ 3 * s ^ 2)
  have q21 := (by positivity : (0 : ℝ) ≤ t ^ 4)
  have q22 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t ^ 4)
  have q23 := (by positivity : (0 : ℝ) ≤ t ^ 4 * s ^ 2)
  have q24 := (by positivity : (0 : ℝ) ≤ t ^ 5)
  have q25 := mul_le_mul_of_nonneg_left hs1 (by positivity : (0 : ℝ) ≤ t ^ 5)
  have q26 := (by positivity : (0 : ℝ) ≤ t ^ 6)
  ring_nf at *
  linarith

theorem lrcPy3x_eq (x a : ℝ) : lrcPy3x x a = lrcPy3s (x - 41 / 25) ((1013 * x + 676) / 2340 - a) := by
  unfold lrcPy3x lrcPy3s
