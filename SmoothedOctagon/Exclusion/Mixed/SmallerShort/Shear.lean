      6) * (1 + (5 / 13 - 2 * n / 39) * (3 * (1 - w) / 19))) (1 + (3 * (1 - w) / 19)) 1 := by
    rw [mul_zero, shrPT1_pos_id]
    exact hp
  exact lt_of_mul_lt_mul_left h0 hL.le

/-- **`V̄ ≤ û`**: for `2 ≤ x ≤ 13/6`,
`V̄(x) ≤ 755/996 + (x - 2)/100` (difference `t(8715t² + 4012t + 1)/(24900(3 + t)(35t + 83))`,
`t = x - 2`). -/
theorem shr_Vbar_le_uhat {x : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) : ssVbar x ≤ ssUhat5 x := by
  have _hx2 := hx2
  unfold ssVbar ssUhat5
  have hx0 : 0 < x := by linarith
  have hd : 0 < (x + 1) * (35 * x + 13) := by positivity
  have ht : 0 ≤ x - 2 := by linarith
  have h : 2 * (x - 1) ^ 2 / ((x + 1) * (35 * x + 13)) ≤ 755 / 996 + (x - 2) / 100 - 3 / 4 := by
    rw [div_le_iff₀ hd]
    linarith [mul_nonneg ht (mul_nonneg ht ht), mul_nonneg ht ht]
  linarith

/-- The residual's factored norm slope is positive while the duration stays below the
incoming switching factor. -/
private theorem shr_factored_slope_pos {S ε r g p q : ℝ} (hS : 0 < S) (hε1 : ε ≤ 1)
    (hr : 0 < r) (hgr : g * r < 1) (hp : 0 ≤ p) (hpr : p ≤ r) (hq : 0 ≤ q) (hq2 : q < 1 / 2) :
    0 < S * (1 - ε * q) * (1 - p * g) + 1 / r - q * g * (2 - p * g) := by
  have hεq := mul_le_mul_of_nonneg_right hε1 hq
  have hfirst : 0 < 1 - ε * q := by linarith
  rcases le_or_gt g 0 with hg | hg
  · have hpg := mul_nonpos_of_nonneg_of_nonpos hp hg
    have hpg1 : 0 < 1 - p * g := by linarith
    have hleft : 0 < S * (1 - ε * q) * (1 - p * g) := by positivity
    have hright : q * g * (2 - p * g) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos hq hg) (by linarith)
    have : 0 < 1 / r := by positivity
    linarith
  · have hpg0 : 0 ≤ p * g := mul_nonneg hp hg.le
    have hpg : p * g < 1 := lt_of_le_of_lt (mul_le_mul_of_nonneg_right hpr hg.le) (by nlinarith)
    have hleft : 0 < S * (1 - ε * q) * (1 - p * g) := by positivity
    have hright : (1 - 2 * q) / r ≤ 1 / r - q * g * (2 - p * g) := by
      have hg_bound : g ≤ 1 / r := by rw [le_div_iff₀ hr]; exact hgr.le
      have h1 : g * (2 - p * g) ≤ 2 / r := by
        have h2 := mul_le_mul_of_nonneg_left (show 2 - p * g ≤ 2 by linarith) hg.le
        calc _ ≤ 2 * g := by nlinarith only [h2]
             _ ≤ 2 * (1 / r) := mul_le_mul_of_nonneg_left hg_bound (by norm_num)
             _ = 2 / r := by ring
      have := mul_le_mul_of_nonneg_left h1 hq
      have he : (1 - 2 * q) / r = 1 / r - q * (2 / r) := by ring
      rw [he]
      nlinarith only [this]
    have : 0 < (1 - 2 * q) / r := div_pos (by linarith) hr
    linarith

/-- The small-shape geometry gives `gr_A < 1`, directly from
`β(2x - α) > 1 + 2x`. -/
theorem shr_small_shape_factor {x be al : ℝ} (hx : 2 ≤ x) (hal : 1 ≤ al) (hal2 : al < 3 / 2)
    (hxb : x ≤ be) : ssDg x be al / al ^ 2 * ssRA al be < 1 := by
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hbe0 : 0 < be := by linarith
  have hshape : 1 + 2 * x < be * (2 * x - al) := by
    have h1 := mul_le_mul_of_nonneg_right hxb (show 0 ≤ 2 * x - al by linarith)
    have h2 := mul_lt_mul_of_pos_left hal2 hx0
    have h3 := mul_nonneg (show 0 ≤ x - 2 by linarith) (show 0 ≤ 2 * x + 1 / 2 by linarith)
    nlinarith
  have e : ssDg x be al / al ^ 2 * ssRA al be =
      1 - (be * (2 * x - al) - 1 - 2 * x) / (al * (al + be)) := by
    unfold ssDg ssRA
    field_simp
    ring
  rw [e]
  have : 0 < (be * (2 * x - al) - 1 - 2 * x) / (al * (al + be)) :=
    div_pos (by linarith) (by positivity)
  linarith

/-- **Monotonicity in the bridge norm**: the affine norm slope factors into a positive
term and a remainder bounded below by `(1 - 2q)/r_A`. -/
theorem shr_norm_mono {x be al p q u u' : ℝ} (hx : 1 < x) (hal : 1 ≤ al)
    (hbe : 0 < be) (hgr : ssDg x be al / al ^ 2 * ssRA al be < 1)
    (hq : 0 ≤ q) (hq2 : q < 1 / 2) (hp : 0 < p) (hpr : p ≤ ssRA al be)
    (huu : u ≤ u') : ssPhi x be al u p 0 q ≤ ssPhi x be al u' p 0 q := by
  have hal0 : 0 < al := by linarith
  have hr : 0 < ssRA al be := by unfold ssRA; positivity
  have hε1 : 1 - 1 / al ^ 2 ≤ 1 := by
    have : 0 ≤ 1 / al ^ 2 := by positivity
    linarith
  have hslope := shr_factored_slope_pos (show 0 < 1 + x by linarith) hε1 hr hgr hp.le hpr hq hq2
  have e : ssPhi x be al u' p 0 q - ssPhi x be al u p 0 q =
      (u' - u) * ((1 + x) * (1 - (1 - 1 / al ^ 2) * q) *
        (1 - p * (ssDg x be al / al ^ 2)) + 1 / ssRA al be -
          q * (ssDg x be al / al ^ 2) * (2 - p * (ssDg x be al / al ^ 2))) := by
    unfold ssPhi ssCp ssLp ssA1 ssA2 ssA3 ssE0 ssRA
    field_simp
    ring
  have := mul_nonneg (sub_nonneg.mpr huu) hslope.le
  linarith

/-- **The second log tangent**: for `y > 0`,
`log y < 5y/4 - 1223/1000` (`log(5/4) > 488/2187`). -/
theorem shr_log_tangent {y : ℝ} (hy : 0 < y) : log y < 5 * y / 4 - 1223 / 1000 := by
  have h1 := Real.log_le_sub_one_of_pos (show 0 < 5 / 4 * y by positivity)
  have h2 : Real.log (5 / 4 * y) = Real.log (5 / 4) + Real.log y :=
    Real.log_mul (by norm_num) hy.ne'
  have h3 := ss_log_ge_cubic (z := 5 / 4) (by norm_num)
  norm_num at h3
  linarith

/-- The parameters `(s, c, n) ∈ [0, 1] × [0, 3/19] × [0, 1]` of the enlarged domain of `shr_J_neg`:
`x = 2 + s/6`, `α = 1 + c`, `β = x(1 + vc)`, `v = 5/13 - 2n/39`. -/
private theorem shr_param {x al be : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) (hal : 1 ≤ al)
    (hal' : al ≤ 22 / 19) (hb : x * (1 + (al - 1) / 3) ≤ be)
    (hb' : be ≤ x * (1 + 5 * (al - 1) / 13)) :
    ∃ s c n : ℝ, 0 ≤ s ∧ s ≤ 1 ∧ 0 ≤ c ∧ c ≤ 3 / 19 ∧ 0 ≤ n ∧ n ≤ 1 ∧ x = 2 + s / 6 ∧
      al = 1 + c ∧ be = (2 + s / 6) * (1 + (5 / 13 - 2 * n / 39) * c) := by
  have hx0 : 0 < x := by linarith
  rcases eq_or_lt_of_le hal with h1 | h1
  · subst h1
    refine ⟨6 * (x - 2), 0, 0, by linarith, by linarith, le_refl _, by norm_num, le_refl _,
      by norm_num, by ring, by ring, ?_⟩
    have : be = x := by nlinarith
    rw [this]
    ring
  · have hc : 0 < al - 1 := by linarith
    have hv1 : x * (al - 1) / 3 ≤ be - x := by nlinarith
    have hv2 : be - x ≤ x * (5 * (al - 1) / 13) := by nlinarith
    refine ⟨6 * (x - 2), al - 1, (5 / 13 - (be - x) / (x * (al - 1))) * 39 / 2, by linarith,
      by linarith, hc.le, by linarith, ?_, ?_, by ring, by ring, ?_⟩
    · have : (be - x) / (x * (al - 1)) ≤ 5 / 13 := by
        rw [div_le_iff₀ (by positivity)]
        linarith
      linarith
    · have : 1 / 3 ≤ (be - x) / (x * (al - 1)) := by
        rw [le_div_iff₀ (by positivity)]
        linarith
      linarith
    · field_simp
      ring

/-- **The three face values are negative**: on the enlarged domain `2 ≤ x ≤ 13/6`, `1 ≤ α ≤ 22/19`,
`x(1 + (α - 1)/3) ≤ β ≤ x(1 + 5(α - 1)/13)`: `J₂ < 0`, `J_θ < 0` (`θ = 223/250`), `J₁ < 0`.
Proof: the numerators `P₂, P_θ, P₁` of `J₂, J_θ, J₁` are positive on the whole
parameter box `(t, c, v)` by three monomial-absorption certificates (`shrP2_pos`, `shrPTth_pos`,
`shrPT1_pos`). -/
theorem shr_J_neg {x al be : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) (hal : 1 ≤ al) (hal' : al ≤ 22 / 19)
    (hb : x * (1 + (al - 1) / 3) ≤ be) (hb' : be ≤ x * (1 + 5 * (al - 1) / 13)) :
    shrJ2 x be al < 0 ∧ shrJt x be al (223 / 250) < 0 ∧ shrJt x be al 1 < 0 := by
  obtain ⟨s, c, n, hs0, hs1, hc0, hc1, hn0, hn1, rfl, rfl, rfl⟩ :=
    shr_param hx hx2 hal hal' hb hb'
  have hx0 : 0 < 2 + s / 6 := by linarith
  have hal0 : 0 < 1 + c := by linarith
  have hv0 : 0 ≤ (5 / 13 - 2 * n / 39) * c := mul_nonneg (by linarith) hc0
  have hb0 : 0 < 1 + c + (2 + s / 6) * (1 + (5 / 13 - 2 * n / 39) * c) := by
    have : 0 < (2 + s / 6) * (1 + (5 / 13 - 2 * n / 39) * c) := mul_pos hx0 (by linarith)
    linarith
  have hD : 0 < shrDu (2 + s / 6) := by unfold shrDu; positivity
  have hC : 0 < shrC (2 + s / 6) (1 + c) := by unfold shrC; positivity
  refine ⟨?_, ?_, ?_⟩
  · rw [shr_J2_eq hx0 hal0 hb0]
    have hP := shrP2_pos (w := 19 * c / 3) hs0 hs1 (by linarith) (by linarith) hn0 hn1
    rw [show 3 * (19 * c / 3) / 19 = c by ring] at hP
    apply div_neg_of_neg_of_pos (by linarith)
    have := mul_pos (mul_pos (mul_pos (mul_pos (by norm_num : (0 : ℝ) < 2000) hal0) hb0) hD)
      (pow_pos hC 2)
    exact this
  · rw [shr_Jt_eq hx0 hal0 hb0 (by norm_num)]
    have hP := shrPTth_pos (w := 1 - 19 * c / 3) hs0 hs1 (by linarith) (by linarith) hn0 hn1
    rw [show 3 * (1 - (1 - 19 * c / 3)) / 19 = c by ring] at hP
    exact div_neg_of_neg_of_pos (by linarith) (mul_pos (mul_pos (mul_pos hal0 hb0) hD) hC)
  · rw [shr_Jt_eq hx0 hal0 hb0 (by norm_num)]
    have hP := shrPT1_pos (w := 1 - 19 * c / 3) hs0 hs1 (by linarith) (by linarith) hn0 hn1
    rw [show 3 * (1 - (1 - 19 * c / 3)) / 19 = c by ring] at hP
    exact div_neg_of_neg_of_pos (by linarith) (mul_pos (mul_pos (mul_pos hal0 hb0) hD) hC)

/-- A function `a + bp + c/p` with `c ≥ 0` is convex on `p > 0`: negative at both ends of
`[p₁, p₂]`, it is negative inside. -/
private theorem shr_inv_conv {a b c p₁ p₂ p : ℝ} (hc : 0 ≤ c) (hp₁ : 0 < p₁) (h1 : p₁ ≤ p)
    (h2 : p ≤ p₂) (hf1 : a + b * p₁ + c / p₁ < 0) (hf2 : a + b * p₂ + c / p₂ < 0) :
    a + b * p + c / p < 0 := by
  rcases eq_or_lt_of_le h1 with h | h
  · rw [← h]; exact hf1
  have hp : 0 < p := by linarith
  have hp₂ : 0 < p₂ := by linarith
  have key : (p₂ - p₁) * (a + b * p + c / p) =
      (p₂ - p) * (a + b * p₁ + c / p₁) + (p - p₁) * (a + b * p₂ + c / p₂) -
        c * (p - p₁) * (p₂ - p) * (p₂ - p₁) / (p * p₁ * p₂) := by
    field_simp
    ring
  have hrem : 0 ≤ c * (p - p₁) * (p₂ - p) * (p₂ - p₁) / (p * p₁ * p₂) := by
    apply div_nonneg _ (by positivity)
    have := mul_nonneg (mul_nonneg (mul_nonneg hc (sub_nonneg.2 h1)) (sub_nonneg.2 h2))
      (sub_nonneg.2 (h1.trans h2))
    exact this
  have hlt : p₁ < p₂ := lt_of_lt_of_le h h2
  have hneg : (p₂ - p) * (a + b * p₁ + c / p₁) + (p - p₁) * (a + b * p₂ + c / p₂) < 0 := by
    have := mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.2 h2) hf1.le
    have := mul_neg_of_pos_of_neg (sub_pos.2 h) hf2
    linarith
  have : (p₂ - p₁) * (a + b * p + c / p) < 0 := by rw [key]; linarith
  by_contra hcon
  have := mul_nonneg (sub_nonneg.2 hlt.le) (not_lt.mp hcon)
  linarith

/-- The face `p = 2q'`, `0 < q' ≤ q_b`: with the second tangent the
residual is below a convex quadratic in `q'`, negative at `q' = 0` and at `q' = q_b` (`J₂`). -/
private theorem shr_face_p2q {X a1 a2 a3 r qb q' : ℝ} (hX : X < -7 / 10) (ha2 : 0 < a2)
    (hr0 : 0 < r) (hqb : 0 < qb) (hq'0 : 0 < q') (hcase : q' ≤ qb)
    (hJ2 : X + 277 / 1000 + qb * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * qb ^ 2 * a2 < 0) :
    X + 1 - 2 * q' * a1 + log (2 * q' / r) + q' * (2 * q' * a2 + 1 / (2 * q') - 1 - a3) < 0 := by
  have hlog2 := shr_log_tangent (show 0 < 2 * q' / r by positivity)
  have e1 : q' * (1 / (2 * q')) = 1 / 2 := by field_simp
  have e2 : 5 * (2 * q' / r) / 4 = q' * (5 / (2 * r)) := by field_simp; ring
  have hf : X + 1 - 2 * q' * a1 + log (2 * q' / r) + q' * (2 * q' * a2 + 1 / (2 * q') - 1 - a3) <
      X + 277 / 1000 + q' * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * q' ^ 2 * a2 := by
    linarith
  have hprod : 0 ≤ a2 * q' * qb * (qb - q') :=
    mul_nonneg (mul_nonneg (mul_nonneg ha2.le hq'0.le) hqb.le) (sub_nonneg.2 hcase)
  have hconv : qb * (X + 277 / 1000 + q' * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * q' ^ 2 * a2) ≤
      (qb - q') * (X + 277 / 1000) +
        q' * (X + 277 / 1000 + qb * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * qb ^ 2 * a2) := by
    linarith
  have h1 := mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.2 hcase) (by linarith : X + 277 / 1000 ≤ 0)
  have h2 := mul_neg_of_pos_of_neg hq'0 hJ2
  by_contra hcon
  have := mul_nonneg hqb.le
    (le_trans (not_lt.mp hcon) hf.le : 0 ≤ X + 277 / 1000 + q' * (5 / (2 * r) - 2 * a1 - 1 - a3) +
      2 * q' ^ 2 * a2)
  linarith

/-- The face `q = q_b`, `2q_b ≤ p ≤ θr` (second tangent; convex in `p`, endpoints `J₂`, `J_θ`). -/
private theorem shr_face_qb_low {X a1 a2 a3 r qb p : ℝ} (hr0 : 0 < r) (hqb : 0 < qb)
    (hp1 : 2 * qb ≤ p) (hpθ : p ≤ 223 / 250 * r)
    (hJ2 : X + 277 / 1000 + qb * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * qb ^ 2 * a2 < 0)
    (hJθ : X + 223 / 250 - 223 / 250 * r * a1 +
      qb * (223 / 250 * r * a2 + 1 / (223 / 250 * r) - 1 - a3) < 0) :
    X + 1 - p * a1 + log (p / r) + qb * (p * a2 + 1 / p - 1 - a3) < 0 := by
  have hp : 0 < p := by linarith
  have hlog2 := shr_log_tangent (show 0 < p / r by positivity)
  have e2 : 5 * (p / r) / 4 = 5 / (4 * r) * p := by field_simp
  have e3 : qb * (1 / p) = qb / p := by ring
  have hg : X + 1 - p * a1 + log (p / r) + qb * (p * a2 + 1 / p - 1 - a3) <
      (X - 223 / 1000 - qb * (1 + a3)) + (5 / (4 * r) - a1 + qb * a2) * p + qb / p := by
    linarith
  have hg1 : (X - 223 / 1000 - qb * (1 + a3)) + (5 / (4 * r) - a1 + qb * a2) * (2 * qb) +
      qb / (2 * qb) < 0 := by
    have e : (X - 223 / 1000 - qb * (1 + a3)) + (5 / (4 * r) - a1 + qb * a2) * (2 * qb) +
        qb / (2 * qb) =
        X + 277 / 1000 + qb * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * qb ^ 2 * a2 := by
      field_simp
      ring
    rw [e]; exact hJ2
  have hg2 : (X - 223 / 1000 - qb * (1 + a3)) + (5 / (4 * r) - a1 + qb * a2) * (223 / 250 * r) +
      qb / (223 / 250 * r) < 0 := by
    have e : (X - 223 / 1000 - qb * (1 + a3)) + (5 / (4 * r) - a1 + qb * a2) * (223 / 250 * r) +
        qb / (223 / 250 * r) =
        X + 223 / 250 - 223 / 250 * r * a1 +
          qb * (223 / 250 * r * a2 + 1 / (223 / 250 * r) - 1 - a3) := by
      field_simp
      ring
    rw [e]; exact hJθ
  have := shr_inv_conv hqb.le (by linarith) hp1 hpθ hg1 hg2
  linarith

/-- The face `q = q_b`, `θr ≤ p ≤ r` (first tangent; convex in `p`, endpoints `J_θ`, `J₁`). -/
private theorem shr_face_qb_high {X a1 a2 a3 r qb p : ℝ} (hr0 : 0 < r) (hqb : 0 < qb)
    (hpθ : 223 / 250 * r ≤ p) (hpr : p ≤ r)
    (hJθ : X + 223 / 250 - 223 / 250 * r * a1 +
      qb * (223 / 250 * r * a2 + 1 / (223 / 250 * r) - 1 - a3) < 0)
    (hJ1 : X + 1 - 1 * r * a1 + qb * (1 * r * a2 + 1 / (1 * r) - 1 - a3) < 0) :
    X + 1 - p * a1 + log (p / r) + qb * (p * a2 + 1 / p - 1 - a3) < 0 := by
  have hθ : (0 : ℝ) < 223 / 250 * r := by positivity
  have hp : 0 < p := by linarith
  have hlog1 := Real.log_le_sub_one_of_pos (show 0 < p / r by positivity)
  have e2 : p / r = 1 / r * p := by ring
  have e3 : qb * (1 / p) = qb / p := by ring
  have hh : X + 1 - p * a1 + log (p / r) + qb * (p * a2 + 1 / p - 1 - a3) ≤
      (X - qb * (1 + a3)) + (1 / r - a1 + qb * a2) * p + qb / p := by
    linarith
  have hh1 : (X - qb * (1 + a3)) + (1 / r - a1 + qb * a2) * (223 / 250 * r) +
      qb / (223 / 250 * r) < 0 := by
    have e : (X - qb * (1 + a3)) + (1 / r - a1 + qb * a2) * (223 / 250 * r) +
        qb / (223 / 250 * r) =
        X + 223 / 250 - 223 / 250 * r * a1 +
          qb * (223 / 250 * r * a2 + 1 / (223 / 250 * r) - 1 - a3) := by
      field_simp
      ring
    rw [e]; exact hJθ
  have hh2 : (X - qb * (1 + a3)) + (1 / r - a1 + qb * a2) * r + qb / r < 0 := by
    have h1r : 1 / r * r = 1 := by field_simp
    have e : (X - qb * (1 + a3)) + (1 / r - a1 + qb * a2) * r + qb / r =
        X + 1 - 1 * r * a1 + qb * (1 * r * a2 + 1 / (1 * r) - 1 - a3) := by
      simp only [one_mul]
      linear_combination h1r
    rw [e]; exact hJ1
  have := shr_inv_conv hqb.le hθ hpθ hpr hh1 hh2
  linarith

/-- The abstract residual argument in the coordinates
`X = E₀ + (û - 1)/r + r`, `a_i = A_i(û)`, `r = r_A`, `q_b`: the `q = 0` face, the `p = 2q` face
and the `q = q_b` face; the residual is affine in `q`. -/
private theorem shr_resid_abstract {X a1 a2 a3 r qb p q : ℝ} (hX : X < -7 / 10) (ha1 : 3 / 2 < a1)
    (ha2 : 0 < a2) (hr : 6 / 19 ≤ r) (hqb : 0 < qb) (hq : 0 ≤ q) (hqqb : q ≤ qb) (hp : 0 < p)
    (hpq : 2 * q ≤ p) (hpr : p ≤ r)
    (hJ2 : X + 277 / 1000 + qb * (5 / (2 * r) - 2 * a1 - 1 - a3) + 2 * qb ^ 2 * a2 < 0)
    (hJθ : X + 223 / 250 - 223 / 250 * r * a1 +
      qb * (223 / 250 * r * a2 + 1 / (223 / 250 * r) - 1 - a3) < 0)
    (hJ1 : X + 1 - 1 * r * a1 + qb * (1 * r * a2 + 1 / (1 * r) - 1 - a3) < 0) :
    X + 1 - p * a1 + log (p / r) + q * (p * a2 + 1 / p - 1 - a3) < 0 := by
  have hr0 : 0 < r := by linarith
  have hy0 : 0 < p / r := by positivity
  have hy1 : p / r ≤ 1 := by rw [div_le_one hr0]; exact hpr
  have hlog1 := Real.log_le_sub_one_of_pos hy0
  have hra1 : 9 / 19 < r * a1 := by
    have := mul_le_mul_of_nonneg_right hr (show 0 ≤ a1 by linarith)
    linarith
  have hpa1 : p * a1 = p / r * (r * a1) := by field_simp
  -- the `q = 0` face
  have hC : X + 1 - p * a1 + log (p / r) < 0 := by
    rw [hpa1]
    rcases le_or_gt (r * a1) 1 with h | h
    · have := mul_le_mul_of_nonneg_right hy1 (sub_nonneg.2 h)
      linarith
    · have := mul_nonpos_of_nonneg_of_nonpos hy0.le (show 1 - r * a1 ≤ 0 by linarith)
      linarith
  -- reduction to `q = q_m` (affine in `q`)
  suffices hm : ∃ qm, q ≤ qm ∧
      X + 1 - p * a1 + log (p / r) + qm * (p * a2 + 1 / p - 1 - a3) < 0 by
    obtain ⟨qm, hqm, hm⟩ := hm
    rcases le_or_gt 0 (p * a2 + 1 / p - 1 - a3) with h | h
    · have := mul_nonneg (sub_nonneg.2 hqm) h
      linarith
    · have := mul_nonpos_of_nonneg_of_nonpos hq h.le
      linarith
  rcases le_or_gt (p / 2) qb with hcase | hcase
  · refine ⟨p / 2, by linarith, ?_⟩
    have := shr_face_p2q (a1 := a1) (a3 := a3) hX ha2 hr0 hqb (by linarith) hcase hJ2
    rw [show 2 * (p / 2) = p by ring] at this
    exact this
  · refine ⟨qb, hqqb, ?_⟩
    rcases le_or_gt p (223 / 250 * r) with hpθ | hpθ
    · exact shr_face_qb_low hr0 hqb (by linarith) hpθ hJ2 hJθ
    · exact shr_face_qb_high hr0 hqb hpθ.le hpr hJθ hJ1

/-- **The residual at `û` is negative below `q_b`**: on the enlarged domain of `shr_J_neg`, for
`0 ≤ q ≤ q_b = (29/30)q_c`, `0 < p`, `2q ≤ p ≤ r_A`: `𝓡(û; p, q) < 0` (`ss_A2_pos`; the `q = 0`
face; affine in `q`; faces `q = q_b`, `p = 2q` through `shr_log_tangent` and `shr_J_neg`). -/
theorem shr_residual_neg {x al be p q : ℝ} (hx : 2 ≤ x) (hx2 : x ≤ 13 / 6) (hal : 1 ≤ al)
    (hal' : al ≤ 22 / 19) (hb : x * (1 + (al - 1) / 3) ≤ be) (hb' : be ≤ x * (1 + 5 * (al - 1) / 13))
    (hq : 0 ≤ q) (hqb : q ≤ 29 / 30 * ssQc x al) (hp : 0 < p) (hpq : 2 * q ≤ p)
    (hpr : p ≤ ssRA al be) : ssPhi x be al (ssUhat5 x) p 0 q < 0 := by
  obtain ⟨hJ2, hJθ, hJ1⟩ := shr_J_neg hx hx2 hal hal' hb hb'
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hbe : 2 * (2 + al) / 3 ≤ be := by
    have := mul_le_mul_of_nonneg_right hx (show 0 ≤ 1 + (al - 1) / 3 by linarith)
    linarith
  have hbe' : 6 * be ≤ 8 + 5 * al := by
    have := mul_le_mul_of_nonneg_right hx2 (show 0 ≤ 1 + 5 * (al - 1) / 13 by linarith)
    linarith
  have hbx : x ≤ be := by
    have := mul_le_mul_of_nonneg_left (show 1 ≤ 1 + (al - 1) / 3 by linarith) hx0.le
    linarith
  have hbe0 : 0 < be := by linarith
  have hab : 0 < al + be := by linarith
  -- `6/19 ≤ r_A ≤ 11/31`
  have hr6 : 6 / 19 ≤ ssRA al be := by
    unfold ssRA; rw [le_div_iff₀ hab]; linarith
  have hr11 : ssRA al be ≤ 11 / 31 := by
    unfold ssRA; rw [div_le_iff₀ hab]; linarith
  have hr0 : 0 < ssRA al be := by linarith
  -- the incoming majorant
  have hu1 : 3 / 4 ≤ ssUhat5 x := by unfold ssUhat5; linarith
  have hu2 : ssUhat5 x ≤ 31 / 40 := by unfold ssUhat5; linarith
  have hu3 : ssUhat5 x - 1 ≤ -6 / 25 := by unfold ssUhat5; linarith
  -- `E₀ ∈ [-1/2, -29/75]`
  have hE0a : ssE0 x (ssUhat5 x) ≤ -29 / 75 := by
    unfold ssE0 ssUhat5
    have h1 : 0 < 1 + x := by linarith
    have ht : 0 ≤ x - 2 := by linarith
    have ht2 : 0 ≤ (x - 2) ^ 2 := sq_nonneg _
    have ht3 : (x - 2) ^ 2 * (x - 2) ≤ (x - 2) ^ 2 * (1 / 6) :=
      mul_le_mul_of_nonneg_left (by linarith) ht2
    have : 1 / (1 + x) ≤ (1 + x) * (1 - (755 / 996 + (x - 2) / 100)) - 29 / 75 := by
      rw [div_le_iff₀ h1]
      linarith
    linarith
  have hE0b : -1 / 2 ≤ ssE0 x (ssUhat5 x) := by
    unfold ssE0 ssUhat5
    have h1 : 0 < 1 + x := by linarith
    have : 6 / 19 ≤ 1 / (1 + x) := by rw [le_div_iff₀ h1]; linarith
    have ht : 0 ≤ x - 2 := by linarith
    have ht2 := mul_self_nonneg (x - 2)
    linarith
  -- `X < -7/10`
  have hX : ssE0 x (ssUhat5 x) + (ssUhat5 x - 1) / ssRA al be + ssRA al be < -7 / 10 := by
    have hinv : 31 / 11 ≤ 1 / ssRA al be := by
      rw [le_div_iff₀ hr0]; linarith
    have : (ssUhat5 x - 1) / ssRA al be ≤ -6 / 25 * (31 / 11) := by
      rw [div_eq_mul_one_div]
      have := mul_le_mul_of_nonpos_left hinv (show ssUhat5 x - 1 ≤ 0 by linarith)
      linarith
    linarith
  -- `A₁ > 3/2`
  have hA1 : 3 / 2 < ssA1 x be al (ssUhat5 x) := by
    have hD : ssDg x be al ≤ 9 / 4 * al ^ 2 := by
      unfold ssDg
      have h1 := mul_nonneg (sub_nonneg.2 hbx) (show 0 ≤ x - al by linarith)
      have h2 := mul_nonneg (show 0 ≤ 2 - al by linarith) (show 0 ≤ 6 / 5 - al by linarith)
      have h3 := mul_nonneg (sub_nonneg.2 hx) (show 0 ≤ 2 * x + 2 - 2 * al by linarith)
      linarith
    have hDE : -(9 / 8) * al ^ 2 ≤ ssDg x be al * ssE0 x (ssUhat5 x) := by
      have h1 := mul_nonneg (sub_nonneg.2 hD) (show 0 ≤ -ssE0 x (ssUhat5 x) by linarith)
      have h2 := mul_le_mul_of_nonneg_left hE0b (sq_nonneg al)
      linarith
    have e : ssA1 x be al (ssUhat5 x) =
        (2 * al ^ 2 - 2 + (1 + x) + ssDg x be al * ssE0 x (ssUhat5 x)) / al ^ 2 := by
      unfold ssA1
      field_simp
    rw [e, lt_div_iff₀ (by positivity)]
    have := mul_le_mul hal' hal' hal0.le (by norm_num)
    linarith
  have hA2 : 0 < ssA2 x be al (ssUhat5 x) := ss_A2_pos hx (by linarith) hal hu1 (by linarith)
  have hqb0 : 0 < 29 / 30 * ssQc x al := by unfold ssQc; positivity
  have ePhi : ssPhi x be al (ssUhat5 x) p 0 q =
      (ssE0 x (ssUhat5 x) + (ssUhat5 x - 1) / ssRA al be + ssRA al be) + 1 -
        p * ssA1 x be al (ssUhat5 x) + log (p / ssRA al be) +
        q * (p * ssA2 x be al (ssUhat5 x) + 1 / p - 1 - ssA3 x be al (ssUhat5 x)) := by
    unfold ssPhi ssCp ssLp
    ring
  have eJ2 : shrJ2 x be al =
      (ssE0 x (ssUhat5 x) + (ssUhat5 x - 1) / ssRA al be + ssRA al be) + 277 / 1000 +
        29 / 30 * ssQc x al * (5 / (2 * ssRA al be) - 2 * ssA1 x be al (ssUhat5 x) - 1 -
          ssA3 x be al (ssUhat5 x)) +
        2 * (29 / 30 * ssQc x al) ^ 2 * ssA2 x be al (ssUhat5 x) := by
    unfold shrJ2
    ring
  have eJt : ∀ τ, shrJt x be al τ =
      (ssE0 x (ssUhat5 x) + (ssUhat5 x - 1) / ssRA al be + ssRA al be) + τ -
        τ * ssRA al be * ssA1 x be al (ssUhat5 x) +
        29 / 30 * ssQc x al * (τ * ssRA al be * ssA2 x be al (ssUhat5 x) +
          1 / (τ * ssRA al be) - 1 - ssA3 x be al (ssUhat5 x)) := by
    intro τ
    unfold shrJt
    ring
  rw [eJ2] at hJ2
  rw [eJt] at hJθ hJ1
  rw [ePhi]
  exact shr_resid_abstract hX hA1 hA2 hr6 hqb0 hq hqb hp hpq hpr hJ2 hJθ hJ1

/-! ### The shape ratios and the physical shear -/

private noncomputable def shrShapeF (s y : ℝ) : ℝ :=
  ((3 + s) * y + 13 / 3 * (1 - y ^ 2)) / (3 + y ^ 2 * s)

/-- The two shape comparisons reduce the fraction to its smallest shape parameters. -/
private theorem shr_shape_fraction_bound {s y : ℝ} (hs : 1 / 9 ≤ s)
    (hy0 : 27 / 31 ≤ y) (hy1 : y ≤ 1) : shrShapeF s y < 11 / 9 := by
  have hy : 0 < y := by linarith
  have hden : 0 < 3 + y ^ 2 * s := by positivity
  have hden0 : 0 < 3 + y ^ 2 * (1 / 9 : ℝ) := by positivity
  have hdec_s : shrShapeF s y ≤ shrShapeF (1 / 9) y := by
    have e : shrShapeF (1 / 9) y - shrShapeF s y =
        (s - 1 / 9) * y * (1 - y ^ 2) * (13 / 3 * y - 3) /
          ((3 + y ^ 2 / 9) * (3 + y ^ 2 * s)) := by
      unfold shrShapeF
      field_simp
      ring
    have hnum : 0 ≤ (s - 1 / 9) * y * (1 - y ^ 2) * (13 / 3 * y - 3) :=
      mul_nonneg (mul_nonneg (mul_nonneg (by linarith) hy.le) (by nlinarith)) (by linarith)
    have h : 0 ≤ shrShapeF (1 / 9) y - shrShapeF s y := by rw [e]; positivity
    linarith
  have hdec_y : shrShapeF (1 / 9) y ≤ shrShapeF (1 / 9) (27 / 31) := by
    have e : shrShapeF (1 / 9) (27 / 31) - shrShapeF (1 / 9) y =
        (y - 27 / 31) * (3 + 1 / 9) *
          (13 / 3 * (y + 27 / 31) - 3 + (1 / 9) * y * (27 / 31)) /
            ((3 + (27 / 31) ^ 2 / 9) * (3 + y ^ 2 / 9)) := by
      unfold shrShapeF
      field_simp
      ring
    have hnum : 0 ≤ (y - 27 / 31) * (3 + 1 / 9) *
        (13 / 3 * (y + 27 / 31) - 3 + (1 / 9) * y * (27 / 31)) :=
      mul_nonneg (mul_nonneg (by linarith) (by norm_num)) (by linarith)
    have h : 0 ≤ shrShapeF (1 / 9) (27 / 31) - shrShapeF (1 / 9) y := by rw [e]; positivity
    linarith
  have hend : shrShapeF (1 / 9) (27 / 31) < 11 / 9 := by norm_num [shrShapeF]
  linarith

/-- Dividing the two shape coordinates leaves a ratio in a fixed positive interval. -/
private theorem shr_shape_ratio_bounds {x δ al : ℝ} (hx : 2 ≤ x) (hδ : 0 ≤ δ)
    (hδ2 : δ ≤ 1 / 19) (hal : 13 / 5 * δ ≤ al - 1) (hal' : al - 1 ≤ 3 * δ) :
    1 / 3 ≤ ssRr x ∧ ssRr x < 1 ∧
      27 / 31 ≤ ssTs al (x * (1 + δ)) / ssRr x ∧
      ssTs al (x * (1 + δ)) / ssRr x ≤ 1 := by
  have hx0 : 0 < x := by linarith
  have hx1 : 0 < x - 1 := by linarith
  have hxS : 0 < x + 1 := by linarith
  have hd : 0 < 1 + δ := by linarith
  have hal0 : 0 < al := by linarith
  let c := al / (1 + δ)
  have hc0 : 1 ≤ c := by dsimp [c]; rw [le_div_iff₀ hd]; linarith
  have hc1 : c ≤ 11 / 10 := by dsimp [c]; rw [div_le_iff₀ hd]; linarith
  have hxc : 0 < x + c := by linarith
  have hbe : 0 < x * (1 + δ) + al := by positivity
  have hy : ssTs al (x * (1 + δ)) / ssRr x =
      (x - c) * (x + 1) / ((x + c) * (x - 1)) := by
    unfold ssTs ssRr
    dsimp [c]
    field_simp
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold ssRr; rw [le_div_iff₀ hxS]; linarith
  · unfold ssRr; rw [div_lt_one hxS]; linarith
  · rw [hy, le_div_iff₀ (mul_pos hxc hx1)]
    have hp := mul_nonneg (show 0 ≤ 11 / 10 - c by linarith)
      (show 0 ≤ 58 * x + 4 by linarith)
    have hq := mul_nonneg (show 0 ≤ x - 2 by linarith)
      (show 0 ≤ 4 * x + 11 / 5 by linarith)
    nlinarith only [hp, hq]
  · rw [hy, div_le_one (mul_pos hxc hx1)]
    have := mul_nonneg (show 0 ≤ c - 1 by linarith) hx0.le
    nlinarith only [this]

/-- The scale floor and the separate shape losses give a lower bound for the shear loss. -/
private theorem shr_shear_loss_lower {x δ al rho : ℝ} (hx : 2 ≤ x) (hδ : 0 ≤ δ)
    (hδ2 : δ ≤ 1 / 19) (hal : 13 / 5 * δ ≤ al - 1) (hal' : al - 1 ≤ 3 * δ)
    (hρ : 0 < rho) (hρ1 : rho < 1) (hq : 29 / 30 * ssQc x al < ssQ al rho) :
    2 * ((x ^ 2 + x + 1) / (1 + x) ^ 2) *
        (2 * (x * (1 + δ)) * x - x - al * (x * (1 + δ))) * (rho / (1 - rho)) / ssRr x >
      2 * (20 / 21) * (3 + (ssRr x) ^ 2) / (3 - ssRr x) := by
  have hx0 : 0 < x := by linarith
  have hal0 : 0 < al := by linarith
  have hal1 : 1 ≤ al := by linarith
  have hal2 : al ≤ 22 / 19 := by linarith
  have hS : 0 < 1 + x := by linarith
  have hxm : 0 < x - 1 := by linarith
  have hx2 : 0 ≤ x - 2 := by linarith
  have halu : 0 ≤ 1 + 3 * δ - al := by linarith
  let R := ssRr x
  have ⟨hR0, hR1, _, _⟩ := shr_shape_ratio_bounds hx hδ hδ2 hal hal'
  have hR : 0 < R := by dsimp [R]; linarith
  have hRm : 0 < 3 - R := by dsimp [R]; linarith
  let X := x * (x + 2)
  let D := 2 * (x * (1 + δ)) * x - x - al * (x * (1 + δ))
  let U1 := (x ^ 2 + x + 1) / (1 + x) ^ 2
  let e : ℝ := 3 / (2 * 19 ^ 2)
  let f0 : ℝ := (22 / 19) ^ 2 / 8
  let lam : ℝ := 29 / 30
  let ζ := lam * (1 - e) / (1 + (1 - lam) * f0)
  let d0 := 2 * x * (x - 1) * (1 - e)
  have hX : 8 ≤ X := by dsimp [X]; nlinarith only [hx]
  have hU : 0 < U1 := by dsimp [U1]; positivity
  have hd0 : 0 < d0 := by dsimp [d0, e]; positivity
  have hδsq : δ ^ 2 ≤ (1 / 19 : ℝ) ^ 2 := by nlinarith only [hδ, hδ2]
  have hD : d0 ≤ D := by
    have h1 : 0 ≤ x * (1 + δ) * (1 + 3 * δ - al) := by positivity
    have h2 : 0 ≤ 2 * x * (x - 2) * δ := by positivity
    have h3 : 0 ≤ 3 * x * ((x - 1) / 19 ^ 2 - δ ^ 2) := by
      apply mul_nonneg (by positivity)
      nlinarith only [hx, hδsq]
    have eD : D - d0 = x * (1 + δ) * (1 + 3 * δ - al) +
        2 * x * (x - 2) * δ + 3 * x * ((x - 1) / 19 ^ 2 - δ ^ 2) := by
      dsimp [D, d0, e]
      ring
    linarith only [h1, h2, h3, eD]
  have hD0 : 0 < D := hd0.trans_le hD
  have haX : al ^ 2 ≤ f0 * X := by
    have ha2 : al ^ 2 ≤ (22 / 19 : ℝ) ^ 2 := by nlinarith only [hal0, hal2]
    dsimp [f0]
    nlinarith only [ha2, hX]
  have hdenq : 0 < 1 + rho * (al ^ 2 - 1) := by
    have : 0 ≤ rho * (al ^ 2 - 1) := mul_nonneg hρ.le (by nlinarith only [hal1])
    linarith
  have hXa : 0 < X + al ^ 2 := by positivity
  have hden : 0 < X + (1 - lam) * al ^ 2 := by dsimp [lam]; positivity
  have hq' : lam * al ^ 2 / (X + al ^ 2) < al ^ 2 * rho / (1 + rho * (al ^ 2 - 1)) := by
    simpa [lam, X, ssQc, ssQ, ssLam, div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hq
  have hq'' := (div_lt_div_iff₀ hXa hdenq).mp hq'
  have hcoef : lam < rho * (X + (1 - lam) * al ^ 2 + lam) := by
    have h : 0 < al ^ 2 * (rho * (X + (1 - lam) * al ^ 2 + lam) - lam) := by
      nlinarith only [hq'']
    have := pos_of_mul_pos_right h (sq_nonneg al)
    linarith only [this]
  have hfloor : lam / (X + (1 - lam) * al ^ 2) < rho / (1 - rho) := by
    rw [div_lt_div_iff₀ hden (by linarith)]
    nlinarith only [hcoef]
  have hdenb : X + (1 - lam) * al ^ 2 ≤ X * (1 + (1 - lam) * f0) := by
    calc
      X + (1 - lam) * al ^ 2 ≤ X + (1 - lam) * (f0 * X) :=
        add_le_add (le_refl X)
          (mul_le_mul_of_nonneg_left haX (show 0 ≤ 1 - lam by norm_num [lam]))
      _ = X * (1 + (1 - lam) * f0) := by ring
  have hfrac : lam / (X * (1 + (1 - lam) * f0)) ≤ lam / (X + (1 - lam) * al ^ 2) :=
    div_le_div_of_nonneg_left (by norm_num [lam]) hden hdenb
  have hf : 0 < lam / (X * (1 + (1 - lam) * f0)) := by dsimp [lam, f0]; positivity
  have hLoss := mul_lt_mul_of_pos_left (hfrac.trans_lt hfloor)
    (show 0 < 2 * U1 * D by positivity)
  have hBase := mul_le_mul_of_nonneg_right hD
    (show 0 ≤ 2 * U1 * (lam / (X * (1 + (1 - lam) * f0))) by positivity)
  have hmin : 2 * U1 * d0 * (lam / (X * (1 + (1 - lam) * f0))) <
      2 * U1 * D * (rho / (1 - rho)) := by
    nlinarith only [hLoss, hBase]
  have hbase : 2 * U1 * d0 * (lam / (X * (1 + (1 - lam) * f0))) / R =
      2 * ζ * (3 + R ^ 2) / (3 - R) := by
    dsimp [U1, d0, X, ζ, R, ssRr, e, f0, lam]
    rw [show 3 - (x - 1) / (x + 1) = 2 * (x + 2) / (x + 1) by field_simp; ring]
    field_simp
    ring
  have hratio := (div_lt_div_iff_of_pos_right hR).mpr hmin
  rw [hbase] at hratio
  have hζ : (20 / 21 : ℝ) < ζ := by norm_num [ζ, lam, e, f0]
  have hshape : 0 < (3 + R ^ 2) / (3 - R) := by positivity
  have hstrict := mul_lt_mul_of_pos_right hζ hshape
  change 2 * (20 / 21) * (3 + R ^ 2) / (3 - R) <
    2 * U1 * D * (rho / (1 - rho)) / R
  calc
    2 * (20 / 21) * (3 + R ^ 2) / (3 - R) =
        2 * ((20 / 21) * ((3 + R ^ 2) / (3 - R))) := by ring
    _ < 2 * (ζ * ((3 + R ^ 2) / (3 - R))) := mul_lt_mul_of_pos_left hstrict (by norm_num)
    _ = 2 * ζ * (3 + R ^ 2) / (3 - R) := by ring
    _ < _ := hratio

/-- **The shear sign above `q_b`**: the scale floor and two monotone shape ratios give
`√3·h·R + 13A/3 < 0` throughout the small-shape domain. The first ratio bounds the
physical shear loss from below; the second controls the anisotropy contribution. -/
theorem shr_shear_sign {x δ al rho : ℝ} (hx : 2 ≤ x) (_hx2 : x ≤ 13 / 6) (hδ : 0 ≤ δ)
    (hδ2 : δ ≤ 1 / 19) (hal : 13 / 5 * δ ≤ al - 1) (hal' : al - 1 ≤ 3 * δ) (hρ : 0 < rho)
    (hρ1 : rho < 1) (hq : 29 / 30 * ssQc x al < ssQ al rho) :
    √3 * ssShear x (x * (1 + δ)) al rho * ssRr x + 13 / 3 * ssAn x (x * (1 + δ)) al < 0 := by
  obtain ⟨hR0, hR1, hy0, hy1⟩ := shr_shape_ratio_bounds hx hδ hδ2 hal hal'
  let R := ssRr x
  let T := ssTs al (x * (1 + δ))
  let y := T / R
  let A := ssAn x (x * (1 + δ)) al
  let L := 2 * ((x ^ 2 + x + 1) / (1 + x) ^ 2) *
    (2 * (x * (1 + δ)) * x - x - al * (x * (1 + δ))) * (rho / (1 - rho))
  have hx0 : 0 < x := by linarith only [hx]
  have hS : 0 < x + 1 := by linarith
  have hxm : 0 < x - 1 := by linarith
  have hal0 : 0 < al := by linarith
  have hbe0 : 0 < x * (1 + δ) := by positivity
  have hK : 0 < al ^ 2 + al * (x * (1 + δ)) + (x * (1 + δ)) ^ 2 := by positivity
  have hR : 0 < R := by dsimp [R]; linarith
  have hRm : 0 < 3 - R := by dsimp [R]; linarith
  have hA : A = R ^ 2 * (1 - y ^ 2) / (3 + y ^ 2 * R ^ 2) := by
    dsimp [A, R, y, T, ssAn, ssRr, ssTs]
    field_simp
    ring
  have hTy : T = y * R := by dsimp [y]; field_simp
  have hf : shrShapeF (R ^ 2) y = (1 + A) * y + 13 / 3 * A / R ^ 2 := by
    rw [hA]
    unfold shrShapeF
    field_simp
    ring
  have hshape : 7 / 6 ≤ (3 + R ^ 2) / (3 - R) := by
    rw [le_div_iff₀ hRm]
    have h : 0 ≤ (R - 1 / 3) * (6 * R + 9) := by
      apply mul_nonneg (by dsimp [R]; linarith) (by linarith)
    nlinarith only [h]
  have hfbound : shrShapeF (R ^ 2) y < 11 / 9 :=
    shr_shape_fraction_bound (by dsimp [R]; nlinarith only [hR0]) hy0 hy1
  have hloss : 2 * (20 / 21) * (3 + R ^ 2) / (3 - R) < L / R :=
    shr_shear_loss_lower hx hδ hδ2 hal hal' hρ hρ1 hq
  have hloss' : (40 / 21) * ((3 + R ^ 2) / (3 - R)) < L / R := by
    convert hloss using 1; ring
  have hneg : 1 + shrShapeF (R ^ 2) y - L / R < 0 := by
    linarith only [hfbound, hshape, hloss']
  have h3 : √3 * √3 = 3 := Real.mul_self_sqrt (by norm_num)
  have hshear : √3 * ssShear x (x * (1 + δ)) al rho = R + (1 + A) * T - L := by
    have hclear : √3 * ssShear x (x * (1 + δ)) al rho =
        (x * (1 + δ) * x - al) * ((x + 2) * al + (2 * x + 1) * (x * (1 + δ))) /
          ((1 + x) ^ 2 * (al ^ 2 + al * (x * (1 + δ)) + (x * (1 + δ)) ^ 2)) - L := by
      unfold ssShear
      change √3 * (√3 / 3 * (_ - L)) = _ - L
      have es : √3 * (√3 / 3) = 1 := by
        calc
          √3 * (√3 / 3) = (√3 * √3) / 3 := by ring
          _ = 1 := by rw [h3]; norm_num
      rw [← mul_assoc, es, one_mul]
    rw [hclear]
    dsimp [R, A, T, ssRr, ssAn, ssTs]
    field_simp
    ring
  have hid : √3 * ssShear x (x * (1 + δ)) al rho * R + 13 / 3 * A =
      R ^ 2 * (1 + shrShapeF (R ^ 2) y - L / R) := by
    rw [hshear, hf, hTy]
    field_simp
    ring
  change √3 * ssShear x (x * (1 + δ)) al rho * R + 13 / 3 * A < 0
  rw [hid]
  exact mul_neg_of_pos_of_neg (sq_pos_of_pos hR) hneg

/-! ### The shear bound -/

namespace SmallerShortData

variable (H : SmallerShortData)

/-- **The shear bound**: on the small-shape domain, `q > (29/30)q_c`, `√3hR + 13A/3 < 0`, hence `h < 0`
and `-hR > 5A/2` (`13/(3√3) > 5/2`, `A ≥ 0`, `R > 0`).
Proof: if `q ≤ q_b`: `root_zero`, `ss_env_weighted` (`m = 0`, `ss_B_factor_pos`), `ss_env_scale`,
`ss_phi_eq` give `0 ≤ 𝓡(u; τq, q)`; `shr_norm_mono` with `u_le_V`, `ss_V_le_Vbar`,
`shr_Vbar_le_uhat`; contradiction with `shr_residual_neg` (`2q < p = τq < r_A`). Then
`shr_shear_sign`. -/
theorem shear_neg (hS : H.SmallShape) :
    29 / 30 * ssQc H.x H.al < H.q ∧
      √3 * ssShear H.x H.be H.al H.rho * ssRr H.x + 13 / 3 * ssAn H.x H.be H.al < 0 ∧
      ssShear H.x H.be H.al H.rho < 0 ∧
      5 / 2 * ssAn H.x H.be H.al < -ssShear H.x H.be H.al H.rho * ssRr H.x := by
  obtain ⟨hx, hx2, hδ0, hδ1, hal1, hal2⟩ := hS
  have hx1 : 1 < H.x := H.one_lt_x
  have hx0 : 0 < H.x := by linarith
  have hbe : H.be = H.x * (1 + H.δ) := by unfold SmallerShortData.δ; field_simp; ring
  have hal : 1 ≤ H.al := H.one_le_al
  have hax : H.al ≤ H.x := H.al_lt_x.le
  have hxb : H.x ≤ H.be := H.x_le_be
  have hρ := H.rho_pos
  have hρ1 : H.rho < 1 := by linarith [H.rho_le]
  -- the scale lower bound `q > q_b`
  have hq : 29 / 30 * ssQc H.x H.al < ssQ H.al H.rho := by
    by_contra hcon
    have hqb := not_lt.mp hcon
    have hq0 : 0 < ssQ H.al H.rho := by
      unfold ssQ ssLam
      have : 0 < 1 + H.rho * (H.al ^ 2 - 1) := by
        have := mul_nonneg hρ.le (show 0 ≤ H.al ^ 2 - 1 by linarith [one_le_pow₀ (n := 2) hal])
        linarith
      positivity
    have hq7 : ssQ H.al H.rho < 1 / 7 := H.q_lt_seventh
    have hτ2 := H.two_lt_τ
    have hτT := H.τ_lt
    have hτ0 : 0 < H.τ := by linarith
    -- the root and the opposite-turn envelope (`m = 0`)
    have ht0 : H.rho * (1 + H.x) ≤ H.t := by
      have h := H.rho_lt_rt
      rw [div_mul_eq_mul_div, one_mul, lt_div_iff₀ (by linarith)] at h
      linarith
    have henv := ss_env_weighted (be := H.be) (u := H.u) (τ := H.τ) (m := 0) hx1 hal hρ ht0
      H.t_le_r H.v_le (fun s hs => by
        rw [add_zero]
        exact ss_B_factor_pos hx1 hal hax hxb hρ hs.1 hτ0.le hτT.le)
    rw [H.root_zero] at henv
    simp only [zero_mul, add_zero] at henv
    obtain ⟨-, -, hR, -⟩ := ss_env_scale (be := H.be) (u := H.u) (τ := H.τ) hx0 hal hq0
      (by linarith : ssQ H.al H.rho < 1)
    rw [(ss_scale_coords (x := H.x) (be := H.be) hal hρ).1] at hR
    rw [hR] at henv
    have hphi := ss_phi_eq (x := H.x) (be := H.be) (al := H.al) (u := H.u) (m := 0)
      (show 0 < H.τ * ssQ H.al H.rho by positivity) hq0
    rw [show H.τ * ssQ H.al H.rho / ssQ H.al H.rho = H.τ by field_simp] at hphi
    have h0 : 0 ≤ ssPhi H.x H.be H.al H.u (H.τ * ssQ H.al H.rho) 0 (ssQ H.al H.rho) := by
      rw [← hphi]
      exact henv
    -- raise `u` to `û`, then the residual at `û` is negative
    have hu : H.u ≤ ssUhat5 H.x :=
      H.u_le_V.trans ((ss_V_le_Vbar hx1).trans (shr_Vbar_le_uhat hx hx2))
    have hgr := shr_small_shape_factor hx hal (by linarith : H.al < 3 / 2) hxb
    have h1 := shr_norm_mono hx1 hal (by linarith : 0 < H.be) hgr hq0.le
      (by linarith : ssQ H.al H.rho < 1 / 2) (by positivity) hτT.le hu
    have hδx : H.x * (1 + (H.al - 1) / 3) ≤ H.be := by
      rw [hbe]
      exact mul_le_mul_of_nonneg_left (by linarith) hx0.le
    have hδx' : H.be ≤ H.x * (1 + 5 * (H.al - 1) / 13) := by
      rw [hbe]
      exact mul_le_mul_of_nonneg_left (by linarith) hx0.le
    have h2τ : 2 * ssQ H.al H.rho ≤ H.τ * ssQ H.al H.rho :=
      mul_le_mul_of_nonneg_right hτ2.le hq0.le
    have h2 := shr_residual_neg hx hx2 hal (by linarith) hδx hδx' hq0.le hqb (by positivity)
      h2τ hτT.le
    linarith
  -- the shear sign
  have hsh : √3 * ssShear H.x H.be H.al H.rho * ssRr H.x + 13 / 3 * ssAn H.x H.be H.al < 0 := by
    rw [hbe]
    exact shr_shear_sign hx hx2 hδ0 hδ1 (by linarith) (by linarith) hρ hρ1 hq
  -- `h < 0` and `-hR > 5A/2`
  have hA : 0 ≤ ssAn H.x H.be H.al := by
    unfold ssAn
    have h1 : 0 ≤ H.be * H.x - H.al := by
      have := mul_le_mul_of_nonneg_right hxb hx0.le
      have := mul_le_mul_of_nonneg_left hx1.le hx0.le
      linarith
    have h2 : 0 ≤ H.al * H.x - H.be := by linarith [H.be_le_al_x]
    have hbe0 : 0 < H.be := by linarith
    have hal0 : 0 < H.al := by linarith
    positivity
  have hRr : 0 < ssRr H.x := by
    unfold ssRr
    exact div_pos (by linarith) (by linarith)
  have hs3 : 0 < √3 := by positivity
  have hs3' : √3 < 26 / 15 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  refine ⟨hq, hsh, ?_, ?_⟩
  · by_contra hcon
    have h1 := mul_nonneg (mul_nonneg hs3.le (not_lt.mp hcon)) hRr.le
    linarith
  · by_contra hcon
    have hX := not_lt.mp hcon
    have h1 := mul_le_mul_of_nonneg_left hX hs3.le
    have h2 := mul_le_mul_of_nonneg_right hs3'.le
      (show 0 ≤ 5 / 2 * ssAn H.x H.be H.al by positivity)
    have e : √3 * (-ssShear H.x H.be H.al H.rho * ssRr H.x) =
        -(√3 * ssShear H.x H.be H.al H.rho * ssRr H.x) := by ring
    linarith

end SmallerShortData

/-- **The shear bound for the actual window**: on the small-shape domain,
`q > (29/30)q_c`, `√3hR + 13A/3 < 0`, `h < 0`, `-hR > 5A/2`, with the physical shear
`h = ssShear (C/a) (B/a) (A/a) ρ`. -/
theorem M2Short.shear_neg (D : M2Short) (h1 : 2 ≤ D.C / D.a) (h2 : D.C / D.a ≤ 13 / 6)
    (h3 : 0 ≤ D.B / D.C - 1) (h4 : D.B / D.C - 1 ≤ 1 / 19)
    (h5 : 1 + 13 / 5 * (D.B / D.C - 1) ≤ D.A / D.a) (h6 : D.A / D.a ≤ 1 + 3 * (D.B / D.C - 1)) :
    29 / 30 * ssQc (D.C / D.a) (D.A / D.a) < ssQ (D.A / D.a) (D.a ^ 2 / (D.a ^ 2 + 4)) ∧
      √3 * ssShear (D.C / D.a) (D.B / D.a) (D.A / D.a) (D.a ^ 2 / (D.a ^ 2 + 4)) *
          ssRr (D.C / D.a) + 13 / 3 * ssAn (D.C / D.a) (D.B / D.a) (D.A / D.a) < 0 ∧
      ssShear (D.C / D.a) (D.B / D.a) (D.A / D.a) (D.a ^ 2 / (D.a ^ 2 + 4)) < 0 ∧
      5 / 2 * ssAn (D.C / D.a) (D.B / D.a) (D.A / D.a) <
        -ssShear (D.C / D.a) (D.B / D.a) (D.A / D.a) (D.a ^ 2 / (D.a ^ 2 + 4)) *
          ssRr (D.C / D.a) := by
  have h := D.toData.shear_neg (D.ss_smallShape h1 h2 h3 h4 h5 h6)
  rw [SmallerShortData.q, D.toData_x, D.toData_be, D.toData_al, D.toData_rho] at h
  exact h

end SmoothedOctagon
