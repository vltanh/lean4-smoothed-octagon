  simp only [centeredPolynomialCancelled, P_a, P_c, P_eps, P_l0, P_l1, P_l2, P_z0, P_z1, Point.T0, Point.K, Point.z1, Point.z2, Point.q, Point.H0, mul_zero, zero_mul, add_zero,
    zero_add, sub_zero, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
    one_pow, mul_one, one_mul, Real.log_one, zero_div, neg_zero]
  all_goals push_cast
  all_goals ring_nf

/-- `base` -/
def fw1_base : IExpr := (.div fw1_cpc (.mul (.mul (.mul (.mul (.const 2 1) (.var 0)) fw1_Q) (.pow (.add (.const 1 1) (.var 2)) 2)) fw1_q))

theorem fw1_base_den (ρ : ℕ → ℝ) : fw1_base.denote ρ = (P ρ).base := by
  simp only [fw1_base, IExpr.denote, fw1_Q_den, fw1_q_den, fw1_cpc_den, hlogR_eq]
  simp only [Point.base, P_a, P_c, P_eps, P_l0, P_l1, P_l2, P_z0, P_z1, Point.T0, Point.K, Point.z1, Point.z2, Point.q, Point.H0, mul_zero, zero_mul, add_zero,
    zero_add, sub_zero, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
    one_pow, mul_one, one_mul, Real.log_one, zero_div, neg_zero]
  all_goals push_cast
  all_goals ring_nf

/-- `phi` -/
def fw1_phi : IExpr := (.sub (.add fw1_base (.div (.mul (.mul (.mul (.mul (.var 2) (.var 1)) fw1_T0) fw1_Bv) fw1_H1) (.mul (.mul (.var 0) fw1_Q) fw1_W))) (.mul (.mul (.mul (.var 2) fw1_d) (.pow (.var 3) 3)) fw1_H2))

theorem fw1_phi_den (ρ : ℕ → ℝ) : fw1_phi.denote ρ = (P ρ).phi := by
  simp only [fw1_phi, IExpr.denote, fw1_T0_den, fw1_d_den, fw1_W_den, fw1_Q_den, fw1_H1_den, fw1_H2_den, fw1_Bv_den, fw1_base_den, hlogR_eq]
  simp only [Point.phi, P_a, P_c, P_eps, P_l0, P_l1, P_l2, P_z0, P_z1, Point.T0, Point.K, Point.z1, Point.z2, Point.q, Point.H0, mul_zero, zero_mul, add_zero,
    zero_add, sub_zero, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
    one_pow, mul_one, one_mul, Real.log_one, zero_div, neg_zero]
  all_goals push_cast
  all_goals ring_nf

/-- `g7` -/
def fw1_g7 : IExpr := (.neg fw1_phi)

theorem fw1_g7_den (ρ : ℕ → ℝ) : fw1_g7.denote ρ = (P ρ).g7 := by
  simp only [fw1_g7, IExpr.denote, fw1_phi_den, hlogR_eq]
  simp only [Point.g7, P_a, P_c, P_eps, P_l0, P_l1, P_l2, P_z0, P_z1, Point.T0, Point.K, Point.z1, Point.z2, Point.q, Point.H0, mul_zero, zero_mul, add_zero,
    zero_add, sub_zero, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
    one_pow, mul_one, one_mul, Real.log_one, zero_div, neg_zero]
  all_goals push_cast
  all_goals ring_nf

/-- The ported residuals. -/
def fw1_fs : List IExpr := [fw1_g7, fw1_turn, fw1_g10]

/-- Nonnegative residuals give `AllNonneg`. -/
theorem fw1_fs_allNonneg (ρ : ℕ → ℝ) : 0 ≤ (P ρ).g7 → 0 ≤ (P ρ).g9 → 0 ≤ (P ρ).g10 → AllNonneg fw1_fs ρ := by
  intro h0 h1 h2 f hf
  simp only [fw1_fs, List.mem_cons, List.not_mem_nil, or_false] at hf
  rcases hf with rfl | rfl | rfl
  · rw [fw1_g7_den]; exact h0
  · rw [fw1_turn_den1]; exact h1
  · rw [fw1_g10_den]; exact h2

end SmoothedOctagon.Interval.Bench
